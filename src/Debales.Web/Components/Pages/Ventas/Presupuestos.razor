@page "/ventas/presupuestos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetSalesQuotesHandler GetQuotes
@inject CreateSalesQuoteHandler CreateHandler
@inject GetItemsHandler GetItems
@inject GetCustomersHandler GetCustomers
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Presupuestos — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Presupuestos de venta</h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nuevo presupuesto</button>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <div class="input-group" style="max-width:340px">
        <input class="form-control" placeholder="Nº presupuesto o cliente…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        <button class="btn btn-outline-secondary" @onclick="Search">Buscar</button>
    </div>
    <select class="form-select" style="max-width:180px" @onchange="OnStatusChanged">
        <option value="">Todos los estados</option>
        <option value="0">Borrador</option>
        <option value="1">Enviado</option>
        <option value="2">Aceptado</option>
        <option value="3">Rechazado</option>
        <option value="4">Expirado</option>
    </select>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Válido hasta</th>
                        <th>Estado</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in _result.Items)
                    {
                        <tr style="cursor:pointer" @onclick="() => GoToQuote(q.Id)">
                            <td><code>@q.Number</code></td>
                            <td>@q.CustomerName</td>
                            <td>@q.Date.ToString("dd/MM/yyyy")</td>
                            <td class="@(q.ValidUntil < DateOnly.FromDateTime(DateTime.Today) && q.Status == SalesQuoteStatus.Sent ? "text-danger fw-semibold" : "")">
                                @q.ValidUntil.ToString("dd/MM/yyyy")
                            </td>
                            <td><span class="badge @StatusBadge(q.Status)">@q.StatusLabel</span></td>
                            <td class="text-end fw-semibold">@q.Total.ToString("N2") €</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick:stopPropagation="true"
                                        @onclick="() => GoToQuote(q.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">@_result.TotalCount resultados</small>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!_result.HasPreviousPage)" @onclick="PrevPage">‹</button>
                <span class="btn btn-sm btn-outline-secondary disabled">@_page / @_result.TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!_result.HasNextPage)" @onclick="NextPage">›</button>
            </div>
        </div>
    }
}

@if (_showCreate)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo presupuesto</h5>
                    <button class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Cliente *</label>
                            <select class="form-select" @bind="_form.CustomerIdStr">
                                <option value="">— Seleccionar —</option>
                                @foreach (var c in _customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha *</label>
                            <input type="date" class="form-control" @bind="_form.Date" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Válido hasta *</label>
                            <input type="date" class="form-control" @bind="_form.ValidUntil" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea class="form-control" rows="2" @bind="_form.Notes"></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-semibold mb-0">Líneas del presupuesto</h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddLine">+ Línea</button>
                    </div>

                    @if (_formLines.Count > 0)
                    {
                        <div class="table-responsive mb-2">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Artículo</th>
                                        <th>Descripción</th>
                                        <th class="text-end" style="width:90px">Cantidad</th>
                                        <th class="text-end" style="width:110px">P. unitario</th>
                                        <th class="text-end" style="width:80px">IVA %</th>
                                        <th class="text-end" style="width:100px">Total</th>
                                        <th style="width:40px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _formLines.Count; i++)
                                    {
                                        var idx = i;
                                        var ln = _formLines[idx];
                                        <tr>
                                            <td>
                                                <select class="form-select form-select-sm" style="min-width:180px"
                                                        value="@ln.ItemIdStr"
                                                        @onchange="e => OnLineItemChanged(idx, e.Value?.ToString())">
                                                    <option value="">— Artículo —</option>
                                                    @foreach (var it in _catalogItems)
                                                    {
                                                        <option value="@it.Id">@it.Code – @it.Name</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input class="form-control form-control-sm" @bind="ln.Description" /></td>
                                            <td><input class="form-control form-control-sm text-end" type="number" step="0.01" min="0.01" @bind="ln.Quantity" /></td>
                                            <td><input class="form-control form-control-sm text-end" type="number" step="0.01" min="0" @bind="ln.UnitPrice" /></td>
                                            <td><input class="form-control form-control-sm text-end" type="number" step="0.01" min="0" @bind="ln.TaxRate" /></td>
                                            <td class="text-end text-nowrap fw-semibold">@LineTotal(ln).ToString("N2") €</td>
                                            <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(idx)">✕</button></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light fw-semibold">
                                        <td colspan="5" class="text-end">Total presupuesto:</td>
                                        <td class="text-end">@_formLines.Sum(LineTotal).ToString("N2") €</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger py-2">@_error</div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreate">Cancelar</button>
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="Save">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Crear presupuesto
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool _loading = true;
    bool _showCreate;
    bool _saving;
    string? _error;
    string? _search;
    SalesQuoteStatus? _statusFilter;
    int _page = 1;
    PagedResult<SalesQuoteSummaryDto>? _result;
    List<ItemSummaryDto> _catalogItems = [];
    List<CustomerSummaryDto> _customers = [];
    CreateForm _form = new();
    List<FormLine> _formLines = [];

    sealed class CreateForm
    {
        public string CustomerIdStr { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Today;
        public DateTime ValidUntil { get; set; } = DateTime.Today.AddDays(30);
        public string? Notes { get; set; }
    }

    sealed class FormLine
    {
        public string ItemIdStr { get; set; } = "";
        public string? Description { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal TaxRate { get; set; } = 21;
    }

    static decimal LineTotal(FormLine l) => l.Quantity * l.UnitPrice * (1 + l.TaxRate / 100m);

    protected override async Task OnInitializedAsync()
    {
        var customersResult = await GetCustomers.Handle(new GetCustomersQuery(null, 1, 200));
        _customers = customersResult.Items.ToList();
        var itemsResult = await GetItems.Handle(new GetItemsQuery(null, null, null, 1, 500));
        _catalogItems = itemsResult.Items.ToList();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _result = await GetQuotes.Handle(new GetSalesQuotesQuery(_search, null, _statusFilter, _page, 20));
        _loading = false;
    }

    async Task OpenCreate()
    {
        _form = new CreateForm();
        _formLines = [];
        _error = null;
        _showCreate = true;
    }

    void CloseCreate() => _showCreate = false;
    void AddLine() => _formLines.Add(new FormLine());
    void RemoveLine(int idx) => _formLines.RemoveAt(idx);

    void OnLineItemChanged(int idx, string? val)
    {
        _formLines[idx].ItemIdStr = val ?? "";
        if (Guid.TryParse(val, out var itemId))
        {
            var item = _catalogItems.FirstOrDefault(i => i.Id == itemId);
            if (item is not null)
                _formLines[idx].UnitPrice = item.SalePrice;
        }
    }

    async Task Save()
    {
        _error = null;
        if (!Guid.TryParse(_form.CustomerIdStr, out var customerId))
        { _error = "Selecciona un cliente."; return; }
        if (_formLines.Count == 0)
        { _error = "Añade al menos una línea."; return; }
        if (_formLines.Any(l => !Guid.TryParse(l.ItemIdStr, out _)))
        { _error = "Todas las líneas deben tener un artículo seleccionado."; return; }

        _saving = true;
        try
        {
            var lines = _formLines.Select(l => new CreateSalesQuoteLineRequest(
                Guid.Parse(l.ItemIdStr), l.Description, l.Quantity, l.UnitPrice, l.TaxRate)).ToList();

            await CreateHandler.Handle(new CreateSalesQuoteCommand(
                customerId,
                DateOnly.FromDateTime(_form.Date),
                DateOnly.FromDateTime(_form.ValidUntil),
                _form.Notes, lines, "web"));

            Toast.Show("Presupuesto creado correctamente.");
            _showCreate = false;
            _page = 1;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    async Task Search() { _page = 1; await LoadAsync(); }
    async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    async Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = int.TryParse(e.Value?.ToString(), out var v) ? (SalesQuoteStatus)v : null;
        _page = 1; await LoadAsync();
    }
    async Task PrevPage() { _page--; await LoadAsync(); }
    async Task NextPage() { _page++; await LoadAsync(); }
    void GoToQuote(Guid id) => Nav.NavigateTo($"/ventas/presupuestos/{id}");

    static string StatusBadge(SalesQuoteStatus s) => s switch
    {
        SalesQuoteStatus.Draft => "bg-secondary",
        SalesQuoteStatus.Sent => "bg-info text-dark",
        SalesQuoteStatus.Accepted => "bg-success",
        SalesQuoteStatus.Rejected => "bg-danger",
        SalesQuoteStatus.Expired => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
