@page "/compras"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetPurchaseOrdersHandler GetPurchaseOrders
@inject GetPurchaseInvoicesHandler GetPurchaseInvoices
@inject GetPurchaseDeliveryNotesHandler GetDeliveryNotes
@inject GetPayablesHandler GetPayables
@inject NavigationManager Nav

<PageTitle>Compras — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Compras</h1>
        <small class="text-muted">Pedidos a proveedor, albaranes y facturación de compras</small>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("/compras/pedidos")'>
                <div class="card-body p-3">
                    <div class="rounded-2 p-2 bg-primary bg-opacity-10 text-primary d-inline-block mb-2">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5z"/></svg>
                    </div>
                    <div class="h4 fw-bold mb-0">@_pendingOrders</div>
                    <div class="small text-muted">Pedidos pendientes</div>
                    <div class="small text-muted mt-1">@_totalOrders en total</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("/compras/albaranes")'>
                <div class="card-body p-3">
                    <div class="rounded-2 p-2 bg-success bg-opacity-10 text-success d-inline-block mb-2">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2m5.5 1.5v2a1 1 0 0 0 1 1h2z"/></svg>
                    </div>
                    <div class="h4 fw-bold mb-0">@_totalNotes</div>
                    <div class="small text-muted">Albaranes recibidos</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="rounded-2 p-2 bg-danger bg-opacity-10 text-danger d-inline-block mb-2">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718z"/></svg>
                    </div>
                    <div class="h4 fw-bold mb-0">@_pendingPayables.ToString("N0") €</div>
                    <div class="small text-muted">Pendiente de pago</div>
                    <div class="small text-muted mt-1">@_payableCount vencimientos</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimos pedidos -->
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Últimos pedidos de compra</span>
                    <a href="/compras/pedidos" class="btn btn-sm btn-outline-primary" style="font-size:.8rem">Ver todos</a>
                </div>
                @if (_recentOrders.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Sin pedidos registrados.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Número</th>
                                    <th>Proveedor</th>
                                    <th>Fecha</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end pe-3">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in _recentOrders)
                                {
                                    <tr style="cursor:pointer" @onclick="() => GoToOrder(o.Id)">
                                        <td class="ps-3 font-monospace small">@o.Number</td>
                                        <td class="small">@o.SupplierName</td>
                                        <td class="small">@o.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end small">@o.Total.ToString("N2") €</td>
                                        <td class="text-end pe-3">
                                            <span class="badge @OrderBadge(o.Status)">@o.StatusLabel</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Vencimientos de pago -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Próximos pagos</span>
                    <a href="/facturacion/compras" class="btn btn-sm btn-outline-primary" style="font-size:.8rem">Ver facturas</a>
                </div>
                @if (_topPayables.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Sin pagos pendientes.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Proveedor</th>
                                    <th>Vence</th>
                                    <th class="text-end pe-3">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _topPayables)
                                {
                                    <tr>
                                        <td class="ps-3 small">@p.SupplierName</td>
                                        <td class="small @(p.DueDate < DateOnly.FromDateTime(DateTime.Today) ? "text-danger" : "")">@p.DueDate.ToString("dd/MM")</td>
                                        <td class="text-end pe-3 small fw-semibold">@p.PendingAmount.ToString("N2") €</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="row g-2">
        <div class="col-6 col-md-3">
            <a href="/compras/pedidos" class="card border-0 shadow-sm text-decoration-none text-dark p-3 d-flex flex-row align-items-center gap-2">
                <svg width="16" height="16" fill="currentColor" class="text-primary" viewBox="0 0 16 16"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5z"/></svg>
                <span class="small fw-semibold">Pedidos a proveedor</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/compras/albaranes" class="card border-0 shadow-sm text-decoration-none text-dark p-3 d-flex flex-row align-items-center gap-2">
                <svg width="16" height="16" fill="currentColor" class="text-success" viewBox="0 0 16 16"><path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2z"/></svg>
                <span class="small fw-semibold">Albaranes de compra</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/facturacion/compras" class="card border-0 shadow-sm text-decoration-none text-dark p-3 d-flex flex-row align-items-center gap-2">
                <svg width="16" height="16" fill="currentColor" class="text-warning" viewBox="0 0 16 16"><path d="M1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/></svg>
                <span class="small fw-semibold">Facturas de compra</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/proveedores" class="card border-0 shadow-sm text-decoration-none text-dark p-3 d-flex flex-row align-items-center gap-2">
                <svg width="16" height="16" fill="currentColor" class="text-info" viewBox="0 0 16 16"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
                <span class="small fw-semibold">Proveedores</span>
            </a>
        </div>
    </div>
}

@code {
    bool _loading = true;
    int _pendingOrders, _totalOrders, _totalNotes, _payableCount;
    decimal _pendingPayables;
    List<PurchaseOrderSummaryDto> _recentOrders = [];
    List<PayableSummaryDto> _topPayables = [];

    protected override async Task OnInitializedAsync()
    {
        var orders = (await GetPurchaseOrders.Handle(new GetPurchaseOrdersQuery(null, null, null, 1, 200))).Items;
        _totalOrders = orders.Count;
        _pendingOrders = orders.Count(o => o.Status == PurchaseOrderStatus.Confirmed);
        _recentOrders = orders.OrderByDescending(o => o.Date).Take(7).ToList();

        _totalNotes = (await GetDeliveryNotes.Handle(new GetPurchaseDeliveryNotesQuery(null, null, null, 1, 500))).Items.Count;

        var pay = (await GetPayables.Handle(new GetPayablesQuery(null, null, null, 1, 200))).Items
            .Where(p => p.Status == PayableStatus.Pending || p.Status == PayableStatus.Partial)
            .ToList();
        _payableCount = pay.Count;
        _pendingPayables = pay.Sum(p => p.PendingAmount);
        _topPayables = pay.OrderBy(p => p.DueDate).Take(6).ToList();

        _loading = false;
    }

    void GoToOrder(Guid id) => Nav.NavigateTo($"/compras/pedidos/{id}");

    static string OrderBadge(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft => "bg-secondary",
        PurchaseOrderStatus.Confirmed => "bg-primary",
        PurchaseOrderStatus.PartiallyReceived => "bg-warning text-dark",
        PurchaseOrderStatus.Received => "bg-success",
        PurchaseOrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}
