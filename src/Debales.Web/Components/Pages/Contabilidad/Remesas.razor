@page "/contabilidad/remesas"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetRemittancesHandler GetAll
@inject GetBankAccountsHandler GetBankAccounts
@inject CreateRemittanceHandler CreateHandler
@inject DeleteRemittanceHandler DeleteHandler
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Remesas — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Remesas</h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nueva remesa</button>
</div>

<p class="text-muted small mb-3">
    Agrupa vencimientos de cobro o pago para gestionar remesas bancarias (SEPA u otros formatos).
</p>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <select class="form-select form-select-sm" style="max-width:160px" @bind="_filterType" @bind:after="LoadAsync">
        <option value="">Todos los tipos</option>
        <option value="1">Cobros</option>
        <option value="2">Pagos</option>
    </select>
    <select class="form-select form-select-sm" style="max-width:160px" @bind="_filterStatus" @bind:after="LoadAsync">
        <option value="">Todos los estados</option>
        <option value="1">Borrador</option>
        <option value="2">Enviada</option>
        <option value="3">Confirmada</option>
        <option value="4">Fallida</option>
    </select>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Banco</th>
                        <th>Documentos</th>
                        <th class="text-end">Total</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _items)
                    {
                        <tr style="cursor:pointer" @onclick="() => GoToDetail(r.Id)">
                            <td><code class="fw-semibold">@r.Number</code></td>
                            <td>@r.Date.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(r.Type == RemittanceType.Collection ? "bg-success-subtle text-success-emphasis" : "bg-primary-subtle text-primary-emphasis")">
                                    @r.TypeLabel
                                </span>
                            </td>
                            <td class="text-muted small">@r.BankAccountName</td>
                            <td><span class="badge bg-light text-dark border">@r.LineCount</span></td>
                            <td class="text-end fw-semibold">@r.Total.ToString("N2") €</td>
                            <td>@StatusBadge(r.Status, r.StatusLabel)</td>
                            <td class="text-end" @onclick:stopPropagation>
                                @if (r.Status == RemittanceStatus.Draft)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmDelete(r.Id, r.Number)">
                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay remesas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_totalPages > 1)
    {
        <nav class="mt-3 d-flex justify-content-center">
            <ul class="pagination pagination-sm">
                @for (int i = 1; i <= _totalPages; i++)
                {
                    var pg = i;
                    <li class="page-item @(pg == _page ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pg)">@pg</button>
                    </li>
                }
            </ul>
        </nav>
    }
}

@if (_showForm)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva remesa</h5>
                    <button class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tipo *</label>
                            <select class="form-select" @bind="_form.Type">
                                <option value="1">Cobros (Collection)</option>
                                <option value="2">Pagos (Payment)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha *</label>
                            <input type="date" class="form-control" @bind="_form.Date" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Cuenta bancaria *</label>
                            <select class="form-select" @bind="_form.BankAccountIdStr" @onfocus="LoadBankAccountsIfNeeded">
                                <option value="">— Selecciona una cuenta —</option>
                                @foreach (var ba in _bankAccounts)
                                {
                                    <option value="@ba.Id">@ba.Name @(ba.Iban is not null ? $"({ba.Iban[..Math.Min(ba.Iban.Length,4)]}...)" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <textarea class="form-control" rows="2" @bind="_form.Notes" placeholder="Observaciones opcionales"></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-danger py-2 mt-3">@_formError</div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="CloseForm">Cancelar</button>
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="Save">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Crear remesa
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_confirmDeleteId.HasValue)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar remesa</h5>
                    <button class="btn-close" @onclick="() => _confirmDeleteId = null"></button>
                </div>
                <div class="modal-body">
                    ¿Eliminar la remesa <strong>@_confirmDeleteNumber</strong>?
                    Esta acción no se puede deshacer.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _confirmDeleteId = null">Cancelar</button>
                    <button class="btn btn-danger" disabled="@_saving" @onclick="ExecuteDelete">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool _loading = true;
    bool _showForm;
    bool _saving;
    string? _formError;
    int _page = 1;
    int _totalPages = 1;
    string _filterType = "";
    string _filterStatus = "";
    List<RemittanceSummaryDto> _items = [];
    List<BankAccountSummaryDto> _bankAccounts = [];
    Guid? _confirmDeleteId;
    string? _confirmDeleteNumber;
    FormModel _form = new();

    sealed class FormModel
    {
        public int Type { get; set; } = 1;
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string BankAccountIdStr { get; set; } = "";
        public string? Notes { get; set; }

        public Guid? BankAccountId => Guid.TryParse(BankAccountIdStr, out var id) ? id : null;
        public RemittanceType RemittanceType => (RemittanceType)Type;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        RemittanceType? type = int.TryParse(_filterType, out var t) ? (RemittanceType)t : null;
        RemittanceStatus? status = int.TryParse(_filterStatus, out var s) ? (RemittanceStatus)s : null;

        var result = await GetAll.Handle(new GetRemittancesQuery(type, status, _page, 20));
        _items = result.Items.ToList();
        _totalPages = (int)Math.Ceiling(result.TotalCount / 20.0);
        _loading = false;
    }

    async Task LoadBankAccountsIfNeeded()
    {
        if (_bankAccounts.Any()) return;
        var result = await GetBankAccounts.Handle(new GetBankAccountsQuery(Page: 1, PageSize: 100));
        _bankAccounts = result.Items.ToList();
    }

    void OpenCreate()
    {
        _form = new FormModel();
        _formError = null;
        _showForm = true;
    }

    void CloseForm() => _showForm = false;

    async Task Save()
    {
        _formError = null;
        if (_form.BankAccountId is null) { _formError = "Selecciona una cuenta bancaria."; return; }

        _saving = true;
        try
        {
            var dto = await CreateHandler.Handle(new CreateRemittanceCommand(
                _form.Date, _form.BankAccountId.Value, _form.RemittanceType, _form.Notes, "web"));
            Toast.Show($"Remesa {dto.Number} creada.");
            _showForm = false;
            Nav.NavigateTo($"/contabilidad/remesas/{dto.Id}");
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    void GoToDetail(Guid id) => Nav.NavigateTo($"/contabilidad/remesas/{id}");

    void GoToPage(int page) { _page = page; _ = LoadAsync(); }

    void ConfirmDelete(Guid id, string number) { _confirmDeleteId = id; _confirmDeleteNumber = number; }

    async Task ExecuteDelete()
    {
        _saving = true;
        try
        {
            await DeleteHandler.Handle(new DeleteRemittanceCommand(_confirmDeleteId!.Value, "web"));
            Toast.Show("Remesa eliminada.");
            _confirmDeleteId = null;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    static RenderFragment StatusBadge(RemittanceStatus status, string label) => __builder =>
    {
        var css = status switch
        {
            RemittanceStatus.Draft => "bg-secondary",
            RemittanceStatus.Sent => "bg-warning text-dark",
            RemittanceStatus.Confirmed => "bg-success",
            RemittanceStatus.Failed => "bg-danger",
            _ => "bg-light text-dark"
        };
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", $"badge {css}");
        __builder.AddContent(2, label);
        __builder.CloseElement();
    };
}
