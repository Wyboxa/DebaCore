<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">@Title</h1>
        <small class="text-muted">@Subtitle</small>
    </div>
    <span class="module-phase-tag">
        <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16">
            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
        </svg>
        @Phase
    </span>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column align-items-center justify-content-center py-5 text-center">
                <div class="module-placeholder-icon mb-4">
                    @((MarkupString)IconSvg)
                </div>
                <h5 class="fw-semibold mb-1">@Title</h5>
                <p class="text-muted small mb-3 px-3">@Subtitle</p>
                <span class="badge bg-light text-secondary border" style="font-size:0.72rem">Próximamente</span>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold small">Funcionalidades previstas</span>
            </div>
            <div class="card-body py-3">
                <div class="row g-0">
                    @foreach (var feature in Features)
                    {
                        <div class="col-md-6 d-flex align-items-start gap-2 py-2 pe-4">
                            <div class="feature-dot mt-1"></div>
                            <span class="small text-muted">@feature</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-wrap icon-teal" style="width:40px;height:40px;border-radius:10px;">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                        </svg>
                    </div>
                    <div>
                        <div class="small fw-semibold">Planificación del módulo</div>
                        <div class="small text-muted">Este módulo está en el roadmap de desarrollo. Se implementará cuando la fase anterior esté estabilizada.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Subtitle { get; set; } = "";
    [Parameter, EditorRequired] public string Phase { get; set; } = "";
    [Parameter, EditorRequired] public string IconSvg { get; set; } = "";
    [Parameter] public IEnumerable<string> Features { get; set; } = [];
}
