# Copia este archivo como .env y rellena los valores antes de ejecutar docker-compose up

# Contraseña del servidor SQL Server (mínimo 8 chars, mayúsculas, números y símbolos)
SA_PASSWORD=PON_AQUI_CONTRASENA_SEGURA_Min8Chars1!

# Secreto JWT — mínimo 32 caracteres, cambiar en producción
JWT_SECRET=CAMBIAR_POR_SECRETO_REAL_MIN_32_CARACTERES_PRODUCCION

# Proveedor IA: Mock (sin API key) | Claude | OpenAI
AI_PROVIDER=Mock
AI_APIKEY=
AI_MODEL=claude-sonnet-4-6

# Puertos expuestos en el host (opcional — por defecto: web=8080, api=5001)
WEB_PORT=8080
API_PORT=5001
