    // ── Asistente IA ─────────────────────────────────────────────────────────────

    private async Task LoadSummary()
    {
        _summaryLoading = true;
        _summary = null;
        StateHasChanged();
        try
        {
            _summary = await SummaryHandler.Handle(new Debales.Application.AI.Summary.GetCustomerSummaryQuery(Id));
        }
        catch (Exception ex) { _summary = $"Error al generar el resumen: {ex.Message}"; }
        finally { _summaryLoading = false; StateHasChanged(); }
    }

    private async Task SendChatMessage()
    {
        var msg = _chatInput.Trim();
        if (string.IsNullOrEmpty(msg) || _chatLoading) return;

        _chatInput = string.Empty;
        _chatError = null;
        _chatMessages.Add(new Debales.Application.AI.ChatMessage("user", msg));
        _chatLoading = true;
        StateHasChanged();

        try
        {
            var history = _chatMessages
                .Take(_chatMessages.Count - 1)
                .ToList();

            var result = await ChatHandler.Handle(
                new Debales.Application.AI.Chat.ChatWithCustomerCommand(Id, history, msg, "web"));

            _chatMessages.Add(new Debales.Application.AI.ChatMessage("assistant", result.Message));
        }
        catch (Exception ex)
        {
            _chatError = $"Error: {ex.Message}";
            _chatMessages.RemoveAt(_chatMessages.Count - 1);
        }
        finally { _chatLoading = false; StateHasChanged(); }
    }

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendChatMessage();
    }
