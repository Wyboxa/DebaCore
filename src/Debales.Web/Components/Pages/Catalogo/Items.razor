@page "/catalogo"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetItemsHandler GetItems
@inject CreateItemHandler CreateHandler
@inject GetCatalogLookupsHandler GetLookups
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Catálogo — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Catálogo de artículos</h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nuevo artículo</button>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <div class="input-group" style="max-width:340px">
        <input class="form-control" placeholder="Código o nombre…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        <button class="btn btn-outline-secondary" @onclick="Search">Buscar</button>
    </div>
    <select class="form-select" style="max-width:180px" @onchange="OnFamilyChanged">
        <option value="">Todas las familias</option>
        @foreach (var f in _lookupData?.Families ?? [])
        {
            <option value="@f.Id">@f.Name</option>
        }
    </select>
    <select class="form-select" style="max-width:160px" @onchange="OnTypeChanged">
        <option value="">Artículos y servicios</option>
        <option value="false">Solo artículos</option>
        <option value="true">Solo servicios</option>
    </select>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Familia</th>
                        <th>Unidad</th>
                        <th>Tipo</th>
                        <th class="text-end">P. venta</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in _result.Items)
                    {
                        <tr style="cursor:pointer" @onclick="() => GoToDetail(i.Id)">
                            <td><code>@i.Code</code></td>
                            <td><strong>@i.Name</strong></td>
                            <td>@(i.FamilyName ?? "—")</td>
                            <td>@i.UnitOfMeasureName</td>
                            <td>
                                @if (i.IsService)
                                {
                                    <span class="badge bg-info text-dark">Servicio</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Artículo</span>
                                }
                            </td>
                            <td class="text-end">@i.SalePrice.ToString("N2") €</td>
                            <td>
                                @if (i.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => GoToDetail(i.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                    @if (!_result.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No se encontraron artículos.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(_result.HasPreviousPage ? "" : "disabled")">
                    <button class="page-link" @onclick="PrevPage">Anterior</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @_result.Page de @_result.TotalPages (@_result.TotalCount total)</span>
                </li>
                <li class="page-item @(_result.HasNextPage ? "" : "disabled")">
                    <button class="page-link" @onclick="NextPage">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (_showCreate)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo artículo</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_form" OnValidSubmit="CreateItem">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">Código *</label>
                                <InputText class="form-control text-uppercase" @bind-Value="_form.Code" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="_form.Name" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Familia</label>
                                <InputSelect class="form-select" @bind-Value="_form.FamilyIdStr">
                                    <option value="">Sin familia</option>
                                    @foreach (var f in _lookupData?.Families ?? [])
                                    {
                                        <option value="@f.Id">@f.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Unidad de medida *</label>
                                <InputSelect class="form-select" @bind-Value="_form.UnitOfMeasureIdStr">
                                    <option value="">Seleccionar…</option>
                                    @foreach (var u in _lookupData?.UnitsOfMeasure ?? [])
                                    {
                                        <option value="@u.Id">@u.Code — @u.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tipo IVA</label>
                                <InputSelect class="form-select" @bind-Value="_form.TaxTypeIdStr">
                                    <option value="">Sin IVA</option>
                                    @foreach (var t in _lookupData?.TaxTypes ?? [])
                                    {
                                        <option value="@t.Id">@t.Code (@t.Rate%)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">P. venta (€)</label>
                                <InputNumber class="form-control" @bind-Value="_form.SalePrice" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">P. compra (€)</label>
                                <InputNumber class="form-control" @bind-Value="_form.PurchasePrice" />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="_form.IsService" id="chkService" />
                                    <label class="form-check-label" for="chkService">Es un servicio (no tiene stock)</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <InputTextArea class="form-control" @bind-Value="_form.Description" rows="2" />
                            </div>
                        </div>
                        @if (_createError is not null)
                        {
                            <div class="alert alert-danger mt-2">@_createError</div>
                        }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreate">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">
                                @(_saving ? "Guardando…" : "Crear artículo")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<ItemSummaryDto>? _result;
    private CatalogLookupsDto? _lookupData;
    private string? _search;
    private Guid? _familyId;
    private bool? _isService;
    private int _page = 1;
    private bool _loading;
    private bool _showCreate;
    private bool _saving;
    private string? _createError;
    private ItemForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _lookupData = await GetLookups.Handle();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _result = await GetItems.Handle(new GetItemsQuery(_search, _familyId, _isService, _page, 20));
        _loading = false;
    }

    private async Task Search() { _page = 1; await LoadAsync(); }
    private async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private async Task OnFamilyChanged(ChangeEventArgs e)
    {
        _familyId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        _isService = bool.TryParse(e.Value?.ToString(), out var b) ? b : null;
        _page = 1;
        await LoadAsync();
    }

    private void GoToDetail(Guid id) => Nav.NavigateTo($"/catalogo/{id}");

    private void OpenCreate() { _form = new(); _createError = null; _showCreate = true; }
    private void CloseCreate() => _showCreate = false;

    private async Task CreateItem()
    {
        _saving = true;
        _createError = null;
        try
        {
            var unitId = Guid.TryParse(_form.UnitOfMeasureIdStr, out var u) ? u : Guid.Empty;
            if (unitId == Guid.Empty) { _createError = "Selecciona una unidad de medida."; _saving = false; return; }

            var item = await CreateHandler.Handle(new CreateItemCommand(
                _form.Code!, _form.Name!, _form.Description,
                _form.IsService, unitId,
                Guid.TryParse(_form.FamilyIdStr, out var f) ? f : null,
                Guid.TryParse(_form.TaxTypeIdStr, out var t) ? t : null,
                _form.SalePrice, _form.PurchasePrice, "web"));
            _showCreate = false;
            Toast.Show("Artículo creado correctamente");
            Nav.NavigateTo($"/catalogo/{item.Id}");
        }
        catch (InvalidOperationException ex) { _createError = ex.Message; }
        catch (ArgumentException ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    private sealed class ItemForm
    {
        public string? Code { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public bool IsService { get; set; }
        public string? FamilyIdStr { get; set; }
        public string? UnitOfMeasureIdStr { get; set; }
        public string? TaxTypeIdStr { get; set; }
        public decimal SalePrice { get; set; }
        public decimal PurchasePrice { get; set; }
    }
}
