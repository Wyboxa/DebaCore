@page "/configuracion/usuarios"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetUsersHandler GetUsers
@inject GetRolesHandler GetRoles
@inject CreateUserHandler CreateUser
@inject AssignRoleHandler AssignRole
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Usuarios — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Usuarios</h1>
        <small class="text-muted">Gestión de acceso a la plataforma</small>
    </div>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ Nuevo usuario</button>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control form-control-sm" placeholder="Buscar por usuario o email…"
               @bind="_search" @bind:event="oninput" @onkeyup="ApplyFilter" />
    </div>
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="_filterActive" @bind:after="ApplyFilter">
            <option value="">Todos</option>
            <option value="true">Activos</option>
            <option value="false">Inactivos</option>
        </select>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Usuario</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Alta</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filtered.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Sin usuarios.</td></tr>
                    }
                    @foreach (var u in _filtered)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@u.Username</td>
                            <td class="text-muted small">@u.Email</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@r</span>
                                }
                            </td>
                            <td class="small text-muted">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (u.IsActive)
                                { <span class="badge bg-success">Activo</span> }
                                else
                                { <span class="badge bg-secondary">Inactivo</span> }
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToDetail(u.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_showCreate)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo usuario</h5>
                    <button class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Usuario *</label>
                            <input class="form-control" @bind="_form.Username" placeholder="nombre.apellido" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" @bind="_form.Email" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Contraseña * (mín. 8 caracteres)</label>
                            <input type="password" class="form-control" @bind="_form.Password" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Rol</label>
                            <select class="form-select" @bind="_form.RoleId">
                                <option value="">— Sin rol —</option>
                                @foreach (var r in _roles)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_createError))
                    {
                        <div class="alert alert-danger py-2 mt-3 small">@_createError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseCreate">Cancelar</button>
                    <button class="btn btn-primary btn-sm" disabled="@_saving" @onclick="SaveCreate">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Crear usuario
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool _loading = true, _saving, _showCreate;
    string _search = "", _filterActive = "", _createError = "";
    List<UserSummaryDto> _all = [], _filtered = [];
    List<RoleDto> _roles = [];

    sealed class CreateForm
    {
        public string Username { get; set; } = "";
        public string Email    { get; set; } = "";
        public string Password { get; set; } = "";
        public string RoleId   { get; set; } = "";
    }
    CreateForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _roles = (await GetRoles.Handle()).ToList();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _all = (await GetUsers.Handle(new GetUsersQuery())).ToList();
        ApplyFilter();
        _loading = false;
    }

    void ApplyFilter()
    {
        IEnumerable<UserSummaryDto> q = _all;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var t = _search.ToLowerInvariant();
            q = q.Where(u => u.Username.ToLowerInvariant().Contains(t) || u.Email.ToLowerInvariant().Contains(t));
        }
        if (_filterActive == "true")  q = q.Where(u => u.IsActive);
        if (_filterActive == "false") q = q.Where(u => !u.IsActive);
        _filtered = q.ToList();
    }

    void OpenCreate() { _form = new(); _createError = ""; _showCreate = true; }
    void CloseCreate() => _showCreate = false;
    void GoToDetail(Guid id) => Nav.NavigateTo($"/configuracion/usuarios/{id}");

    async Task SaveCreate()
    {
        _createError = "";
        if (string.IsNullOrWhiteSpace(_form.Username)) { _createError = "El usuario es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_form.Email))    { _createError = "El email es obligatorio."; return; }
        if (_form.Password.Length < 8)                 { _createError = "La contraseña debe tener al menos 8 caracteres."; return; }

        _saving = true;
        try
        {
            var dto = await CreateUser.Handle(new CreateUserCommand(_form.Username, _form.Email, _form.Password, "web"));

            if (!string.IsNullOrEmpty(_form.RoleId) && Guid.TryParse(_form.RoleId, out var roleId))
                await AssignRole.Handle(new AssignRoleCommand(dto.Id, roleId, "web"));

            Toast.Show($"Usuario '{dto.Username}' creado.");
            _showCreate = false;
            await LoadAsync();
        }
        catch (Exception ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }
}
