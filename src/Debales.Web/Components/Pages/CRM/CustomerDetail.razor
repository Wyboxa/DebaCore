                    <EditForm Model="_editForm" OnValidSubmit="SaveEdit">
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="_editForm.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Sector</label>
                                <InputText class="form-control" @bind-Value="_editForm.Sector" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">CIF / NIF</label>
                                <InputText class="form-control" @bind-Value="_editForm.TaxId" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="_editForm.Phone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="_editForm.Email" type="email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Web</label>
                                <InputText class="form-control" @bind-Value="_editForm.Website" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cuenta contable</label>
                            <InputText class="form-control" @bind-Value="_editForm.AccountCode" placeholder="p.ej. 4300001" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tarifa de precio</label>
                            <select class="form-select" @bind="_editForm.PriceListIdStr">
                                <option value="">Sin tarifa</option>
                                @foreach (var pl in _availablePriceLists)
                                {
                                    <option value="@pl.Id">@pl.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Condición de pago</label>
                            <select class="form-select" @bind="_editForm.PaymentTermIdStr">
                                <option value="">Sin condición</option>
                                @foreach (var pt in _availablePaymentTerms)
                                {
                                    <option value="@pt.Id">@pt.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Forma de pago</label>
                            <select class="form-select" @bind="_editForm.PaymentMethodIdStr">
                                <option value="">Sin forma de pago</option>
                                @foreach (var pm in _availablePaymentMethods)
                                {
                                    <option value="@pm.Id">@pm.Name</option>
                                }
                            </select>
                        </div>
                        <hr class="my-2" />
                        <div class="small text-muted fw-semibold mb-2">Dirección</div>
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Calle</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressStreet" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ciudad</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressCity" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">C.P.</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressPostalCode" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">País</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressCountry" />
                            </div>
                        </div>
                        @if (_editError is not null) { <div class="alert alert-danger mt-2">@_editError</div> }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="() => _showEdit = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Debales.Application.CRM.Customers.DTOs.CustomerDetailDto? _customer;
    private IReadOnlyList<Debales.Application.CRM.Contacts.DTOs.ContactDto> _contacts = [];
    private IReadOnlyList<Debales.Application.CRM.Activities.DTOs.ActivityDto> _activities = [];
    private IReadOnlyList<Debales.Application.CRM.Notes.DTOs.NoteDto> _notes = [];
    private IReadOnlyList<Debales.Application.CRM.Opportunities.DTOs.OpportunityDto> _opportunities = [];

    private bool _loading = true;
    private string _tab = "info";
    private bool _saving;

    // Edit customer
    private bool _showEdit;
    private string? _editError;
    private EditFormModel _editForm = new();

    // Add contact
    private bool _showAddContact;
    private string? _contactError;
    private ContactFormModel _contactForm = new();

    // Log activity
    private bool _showLogActivity;
    private string? _actError;
    private ActivityFormModel _actForm = new();

    // Add note
    private bool _showAddNote;
    private string? _noteError;
    private NoteFormModel _noteForm = new();

    // Add opportunity
    private bool _showAddOpp;
    private string? _oppError;
    private OppFormModel _oppForm = new();

    // Item codes
    private List<CustomerItemCodeDto> _customerCodes = [];
    private List<ItemSummaryDto> _allItemsForCodes = [];
    private bool _customerCodesLoading;
    private bool _showCustomerCodeModal;
    private CustomerItemCodeDto? _editingCustomerCode;
    private CustomerItemCodeDto? _deletingCustomerCode;
    private string? _customerCodeError;
    private CustomerCodeForm _customerCodeForm = new();

    // Asistente IA
    private string? _summary;
    private bool _summaryLoading;
    private bool _chatLoading;
    private string? _chatError;
    private string _chatInput = string.Empty;
    private List<Debales.Application.AI.ChatMessage> _chatMessages = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomerAsync();
        await LoadContactsAsync();
        await LoadActivitiesAsync();
        await LoadNotesAsync();
        await LoadOpportunitiesAsync();
        _loading = false;
    }

    private async Task LoadCustomerAsync() =>
        _customer = await GetById.Handle(new GetCustomerByIdQuery(Id));

    private async Task LoadContactsAsync() =>
        _contacts = await GetContacts.Handle(new GetContactsByCustomerQuery(Id));

    private async Task LoadActivitiesAsync() =>
        _activities = await GetActivities.Handle(new GetActivitiesByCustomerQuery(Id));

    private async Task LoadNotesAsync() =>
        _notes = await GetNotes.Handle(new Debales.Application.CRM.Notes.Queries.GetNotesByCustomer.GetNotesByCustomerQuery(Id));

    private async Task LoadOpportunitiesAsync() =>
        _opportunities = await GetOpportunities.Handle(new GetOpportunitiesByCustomerQuery(Id));

    Debales.Application.Common.StatementDto? _statement;
    bool _statementLoading;
    List<SalesOrderSummaryDto> _pedidos = [];
    bool _pedidosLoading;

    private void SetTab(string tab)
    {
        _tab = tab;
        if (tab == "asistente" && _summary is null && !_summaryLoading)
            _ = LoadSummary();
        if (tab == "codigos" && !_customerCodes.Any())
            _ = LoadCustomerCodesAsync();
        if (tab == "cuenta" && _statement is null && !_statementLoading)
            _ = LoadStatementAsync();
        if (tab == "pedidos" && !_pedidos.Any() && !_pedidosLoading)
            _ = LoadPedidosAsync();
    }

    private async Task LoadPedidosAsync()
    {
        _pedidosLoading = true;
        var result = await GetOrders.Handle(new GetSalesOrdersQuery(null, Id, null, 1, 200));
        _pedidos = result.Items.ToList();
        _pedidosLoading = false;
        StateHasChanged();
    }

    private void GoToOrder(Guid orderId) => Nav.NavigateTo($"/ventas/pedidos/{orderId}");

    private static string OrderBadge(SalesOrderStatus s) => s switch
    {
        SalesOrderStatus.Draft              => "bg-secondary",
        SalesOrderStatus.Confirmed          => "bg-primary",
        SalesOrderStatus.PartiallyDelivered => "bg-warning text-dark",
        SalesOrderStatus.Delivered          => "bg-success",
        SalesOrderStatus.Cancelled          => "bg-danger",
        _                                   => "bg-secondary"
    };

    private async Task LoadStatementAsync()
    {
        _statementLoading = true;
        _statement = await StatementHandler.Handle(new GetCustomerStatementQuery(Id));
        _statementLoading = false;
        StateHasChanged();
    }

    private static string CustomerStmtBadge(string type) => type switch
    {
        "Factura" => "bg-warning text-dark",
        "Rectificativa" => "bg-secondary",
        "Cobro" => "bg-success",
        _ => "bg-light text-dark border"
    };

    private async Task LoadCustomerCodesAsync()
    {
        _customerCodesLoading = true;
        _customerCodes = await GetCustomerItemCodes.Handle(new GetCustomerItemCodesQuery(Id));
        _customerCodesLoading = false;
        StateHasChanged();
    }

    private async Task OpenAddCustomerCode()
    {
        if (!_allItemsForCodes.Any())
        {
            var paged = await GetItems.Handle(new GetItemsQuery(null, null, null, 1, 1000));
            _allItemsForCodes = paged.Items.ToList();
        }
        _editingCustomerCode = null;
        _customerCodeForm = new();
        _customerCodeError = null;
        _showCustomerCodeModal = true;
    }

    private void OpenEditCustomerCode(CustomerItemCodeDto c)
    {
        _editingCustomerCode = c;
        _customerCodeForm = new CustomerCodeForm { CustomerCode = c.CustomerCode, Description = c.Description };
        _customerCodeError = null;
        _showCustomerCodeModal = true;
    }

    private async Task SaveCustomerCode()
    {
        var itemId = _editingCustomerCode?.ItemId ?? (Guid.TryParse(_customerCodeForm.ItemIdStr, out var g) ? g : Guid.Empty);
        if (itemId == Guid.Empty) { _customerCodeError = "Selecciona un artículo."; return; }
        if (string.IsNullOrWhiteSpace(_customerCodeForm.CustomerCode)) { _customerCodeError = "El código del cliente es obligatorio."; return; }

        _saving = true;
        _customerCodeError = null;
        try
        {
            await UpsertCustomerItemCode.Handle(new UpsertCustomerItemCodeCommand(
                Id, itemId, _customerCodeForm.CustomerCode!, _customerCodeForm.Description, "web"));
            _showCustomerCodeModal = false;
            await LoadCustomerCodesAsync();
            Toast.Show("Código guardado");
        }
        catch (Exception ex) { _customerCodeError = ex.Message; }
        finally { _saving = false; }
    }

    private void ConfirmDeleteCustomerCode(CustomerItemCodeDto c) => _deletingCustomerCode = c;

    private async Task ExecuteDeleteCustomerCode()
    {
        if (_deletingCustomerCode is null) return;
        _saving = true;
        try
        {
            await DeleteCustomerItemCode.Handle(new DeleteCustomerItemCodeCommand(Id, _deletingCustomerCode.ItemId));
            _deletingCustomerCode = null;
            await LoadCustomerCodesAsync();
            Toast.Show("Código eliminado");
        }
        catch (Exception ex) { Toast.Show(ex.Message); }
        finally { _saving = false; }
    }

    private sealed class CustomerCodeForm
    {
        public string? ItemIdStr { get; set; }
        public string? CustomerCode { get; set; }
        public string? Description { get; set; }
    }

    // ── Timeline ─────────────────────────────────────────────────────────────────

    private sealed record TimelineItem(
        DateTime Date, string DotClass, string BadgeClass, string KindLabel,
        string Title, string? Detail, string? Author, bool IsPending, bool IsOverdue);

    private IEnumerable<TimelineItem> BuildTimeline()
    {
        var now = DateTime.UtcNow;

        var acts = _activities.Select(a => new TimelineItem(
            a.ScheduledAt,
            "dot-activity", "bg-success", ActivityTypeLabel(a.Type),
            a.Subject, a.Notes, a.AssignedTo,
            !a.IsCompleted, !a.IsCompleted && a.ScheduledAt < now));

        var notes = _notes.Select(n => new TimelineItem(
            n.CreatedAt,
            "dot-note", "bg-secondary", "Nota",
            n.Content, null, n.CreatedBy,
            false, false));

        var opps = _opportunities.Select(o => new TimelineItem(
            o.CreatedAt,
            "dot-opportunity", "bg-warning text-dark", "Oportunidad",
            o.Title,
            o.EstimatedValue.HasValue ? $"{o.EstimatedValue.Value:N0} € · {OppStatusLabel(o.Status)}" : OppStatusLabel(o.Status),
            o.CreatedBy,
            false, false));

        return acts.Concat(notes).Concat(opps).OrderByDescending(x => x.Date);
    }

    private static string ActivityTypeLabel(string type) => type switch
    {
        "Call"    => "Llamada",
        "Meeting" => "Reunión",
        "Email"   => "Email",
        "Task"    => "Tarea",
        "Other"   => "Otro",
        _         => type
    };

    private static string OppStatusLabel(string status) => status switch
    {
        "New"        => "Nuevo",
        "InProgress" => "En curso",
        "Won"        => "Ganado",
        "Lost"       => "Perdido",
        _            => status
    };

    private static string TabLabel(string tab) => tab switch
    {
        "info"          => "Información",
        "contactos"     => "Contactos",
        "actividades"   => "Actividades",
        "notas"         => "Notas",
        "oportunidades" => "Oportunidades",
        "historial"     => "Historial",
        "codigos"       => "Códigos",
        "pedidos"       => "Pedidos",
        "cuenta"        => "Estado de cuenta",
        "asistente"     => "Asistente IA",
        _ => tab
    };

    private static string BadgeClass(string status) => status switch
    {
        "Won" => "bg-success",
        "Lost" => "bg-danger",
        "InProgress" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    // ── Edit customer ────────────────────────────────────────────────────────────

    private List<PriceListSummaryDto> _availablePriceLists = [];
    private List<PaymentTermSummaryDto> _availablePaymentTerms = [];
    private List<PaymentMethodSummaryDto> _availablePaymentMethods = [];

    private async Task OpenEdit()
    {
        _editError = null;
        if (!_availablePriceLists.Any())
        {
            var result = await GetPriceLists.Handle(new GetPriceListsQuery(null, true, 1, 200));
            _availablePriceLists = result.Items.ToList();
        }
        if (!_availablePaymentTerms.Any())
        {
            var result = await GetPaymentTermsList.Handle(new GetPaymentTermsQuery(IsActive: true, Page: 1, PageSize: 200));
            _availablePaymentTerms = result.Items.ToList();
        }
        if (!_availablePaymentMethods.Any())
        {
            var result = await GetPaymentMethodsList.Handle(new GetPaymentMethodsQuery(IsActive: true, Page: 1, PageSize: 200));
            _availablePaymentMethods = result.Items.ToList();
        }
        _editForm = new()
        {
            Name    = _customer!.Name,
            Sector  = _customer.Sector,
            TaxId   = _customer.TaxId,
            Phone   = _customer.Phone,
            Email   = _customer.Email,
            Website = _customer.Website,
            AddressStreet     = _customer.Address?.Street,
            AddressCity       = _customer.Address?.City,
            AddressPostalCode = _customer.Address?.PostalCode,
            AddressCountry    = _customer.Address?.Country,
            AccountCode       = _customer.AccountCode,
            PriceListIdStr    = _customer.PriceListId?.ToString(),
            PaymentTermIdStr  = _customer.PaymentTermId?.ToString(),
            PaymentMethodIdStr = _customer.PaymentMethodId?.ToString()
        };
        _showEdit = true;
    }

    private async Task SaveEdit()
    {
        _saving = true;
        _editError = null;
        try
        {
            var priceListId = Guid.TryParse(_editForm.PriceListIdStr, out var plId) ? plId : (Guid?)null;
            var paymentTermId = Guid.TryParse(_editForm.PaymentTermIdStr, out var ptId) ? ptId : (Guid?)null;
            var paymentMethodId = Guid.TryParse(_editForm.PaymentMethodIdStr, out var pmId) ? pmId : (Guid?)null;
            _customer = await UpdateHandler.Handle(new UpdateCustomerCommand(
                Id, _editForm.Name!, _editForm.Sector, _editForm.TaxId, _editForm.Phone,
                _editForm.Email, _editForm.Website,
                _editForm.AddressStreet, _editForm.AddressCity,
