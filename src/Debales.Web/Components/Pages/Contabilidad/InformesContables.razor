@page "/contabilidad/informes"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetTrialBalanceHandler TrialBalanceHandler
@inject GetJournalBookHandler JournalBookHandler
@inject GetBalanceSheetHandler BalanceSheetHandler
@inject GetFiscalYearsHandler FiscalYearsHandler

<PageTitle>Informes contables — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Informes contables</h1>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Ejercicio</label>
                <select class="form-select" @onchange="OnYearChanged">
                    <option value="">— Seleccionar ejercicio —</option>
                    @foreach (var y in _years)
                    {
                        <option value="@y.Id" selected="@(_selectedYearId == y.Id)">@y.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Período</label>
                <select class="form-select" @onchange="OnPeriodChanged" disabled="@(!_periods.Any())">
                    <option value="">— Todo el ejercicio —</option>
                    @foreach (var p in _periods)
                    {
                        <option value="@p.Id" selected="@(_selectedPeriodId == p.Id)">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Desde</label>
                <input type="date" class="form-control" @bind="_from" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Hasta</label>
                <input type="date" class="form-control" @bind="_to" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="LoadCurrentTab" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Generar
                </button>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <button class="nav-link @(_tab == 0 ? "active" : "")" @onclick="() => SetTab(0)">
            Balance de comprobación
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_tab == 1 ? "active" : "")" @onclick="() => SetTab(1)">
            Libro diario
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_tab == 2 ? "active" : "")" @onclick="() => SetTab(2)">
            Balance de situación
        </button>
    </li>
</ul>

@if (_tab == 0)
{
    @if (_trialBalance is null)
    {
        <div class="text-muted text-center py-5">Selecciona un período y pulsa Generar</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Balance de comprobación de sumas y saldos</span>
                <small class="text-muted">@PeriodLabel()</small>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cuenta</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th class="text-end">Debe</th>
                            <th class="text-end">Haber</th>
                            <th class="text-end">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _trialBalance.Lines)
                        {
                            <tr>
                                <td><code>@l.AccountCode</code></td>
                                <td>@l.AccountName</td>
                                <td class="text-muted small">@AccountTypeLabel(l.AccountType)</td>
                                <td class="text-end">@l.TotalDebit.ToString("N2")</td>
                                <td class="text-end">@l.TotalCredit.ToString("N2")</td>
                                <td class="text-end fw-semibold @(l.Balance < 0 ? "text-danger" : "")">
                                    @l.Balance.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-dark">
                        <tr class="fw-bold">
                            <td colspan="3">TOTALES</td>
                            <td class="text-end">@_trialBalance.GrandTotalDebit.ToString("N2")</td>
                            <td class="text-end">@_trialBalance.GrandTotalCredit.ToString("N2")</td>
                            <td class="text-end @(Math.Abs(_trialBalance.GrandTotalDebit - _trialBalance.GrandTotalCredit) < 0.01m ? "text-success" : "text-danger")">
                                @(_trialBalance.GrandTotalDebit - _trialBalance.GrandTotalCredit).ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

@if (_tab == 1)
{
    @if (_journalBook is null)
    {
        <div class="text-muted text-center py-5">Selecciona un período y pulsa Generar</div>
    }
    else
    {
        <div class="text-muted small mb-2">@_journalBook.Count asientos encontrados</div>
        @foreach (var entry in _journalBook)
        {
            <div class="card border-0 shadow-sm mb-2">
                <div class="card-header bg-transparent py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <code class="me-2">@entry.Number</code>
                        <span class="text-muted me-2">@entry.Date.ToString("dd/MM/yyyy")</span>
                        <span class="badge bg-secondary me-2">@entry.JournalCode</span>
                        <span>@entry.Description</span>
                    </div>
                    <div class="text-muted small text-end">
                        D: @entry.TotalDebit.ToString("N2") · H: @entry.TotalCredit.ToString("N2")
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var l in entry.Lines)
                            {
                                <tr>
                                    <td style="width:100px"><code>@l.AccountCode</code></td>
                                    <td>@l.Description</td>
                                    <td class="text-end" style="width:110px">
                                        @(l.Debit > 0 ? l.Debit.ToString("N2") : "")
                                    </td>
                                    <td class="text-end" style="width:110px">
                                        @(l.Credit > 0 ? l.Credit.ToString("N2") : "")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

@if (_tab == 2)
{
    @if (_balanceSheet is null)
    {
        <div class="text-muted text-center py-5">Selecciona una fecha de corte y pulsa Generar</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var group in _balanceSheet.Groups)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent fw-semibold">@group.TypeLabel</div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    @foreach (var l in group.Lines)
                                    {
                                        <tr>
                                            <td><code>@l.AccountCode</code></td>
                                            <td>@l.AccountName</td>
                                            <td class="text-end fw-semibold">@l.Balance.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr class="fw-bold">
                                        <td colspan="2">Total @group.TypeLabel</td>
                                        <td class="text-end">@group.Total.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col">
                        <div class="text-muted small">TOTAL ACTIVO</div>
                        <div class="fs-4 fw-bold">@_balanceSheet.TotalAssets.ToString("N2") €</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">PASIVO + PATRIMONIO</div>
                        <div class="fs-4 fw-bold">@_balanceSheet.TotalLiabilitiesAndEquity.ToString("N2") €</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">CUADRA</div>
                        <div class="fs-4 fw-bold @(_balanceSheet.IsBalanced ? "text-success" : "text-danger")">
                            @(_balanceSheet.IsBalanced ? "Sí" : "No")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    int _tab;
    bool _loading;

    // Ejercicios y períodos
    IReadOnlyList<FiscalYearDetailDto> _years = [];
    IReadOnlyList<FiscalPeriodDto> _periods = [];
    Guid? _selectedYearId;
    Guid? _selectedPeriodId;

    // Filtro compartido
    DateTime? _from;
    DateTime? _to;

    // Resultados por tab
    TrialBalanceDto? _trialBalance;
    IReadOnlyList<JournalBookEntryDto>? _journalBook;
    BalanceSheetDto? _balanceSheet;

    protected override async Task OnInitializedAsync()
    {
        _years = await FiscalYearsHandler.Handle(new GetFiscalYearsQuery());

        // Auto-seleccionar el ejercicio más reciente abierto
        var current = _years.FirstOrDefault(y => y.Status == FiscalYearStatus.Open)
                   ?? _years.OrderByDescending(y => y.StartDate).FirstOrDefault();
        if (current is not null)
        {
            _selectedYearId = current.Id;
            _periods = current.Periods;
            _from = current.StartDate.ToDateTime(TimeOnly.MinValue);
            _to = current.EndDate.ToDateTime(TimeOnly.MaxValue);
        }
    }

    void OnYearChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedYearId = id;
            var year = _years.FirstOrDefault(y => y.Id == id);
            if (year is not null)
            {
                _periods = year.Periods;
                _from = year.StartDate.ToDateTime(TimeOnly.MinValue);
                _to = year.EndDate.ToDateTime(TimeOnly.MaxValue);
            }
        }
        else
        {
            _selectedYearId = null;
            _periods = [];
            _from = null;
            _to = null;
        }
        _selectedPeriodId = null;
        ClearResults();
    }

    void OnPeriodChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedPeriodId = id;
            var period = _periods.FirstOrDefault(p => p.Id == id);
            if (period is not null)
            {
                _from = period.StartDate.ToDateTime(TimeOnly.MinValue);
                _to = period.EndDate.ToDateTime(TimeOnly.MaxValue);
            }
        }
        else
        {
            _selectedPeriodId = null;
            var year = _years.FirstOrDefault(y => y.Id == _selectedYearId);
            if (year is not null)
            {
                _from = year.StartDate.ToDateTime(TimeOnly.MinValue);
                _to = year.EndDate.ToDateTime(TimeOnly.MaxValue);
            }
        }
        ClearResults();
    }

    async Task SetTab(int tab)
    {
        _tab = tab;
        if (_from.HasValue || _to.HasValue)
            await LoadCurrentTab();
    }

    async Task LoadCurrentTab()
    {
        _loading = true;
        var from = _from.HasValue ? DateOnly.FromDateTime(_from.Value) : (DateOnly?)null;
        var to = _to.HasValue ? DateOnly.FromDateTime(_to.Value) : (DateOnly?)null;

        if (_tab == 0)
            _trialBalance = await TrialBalanceHandler.Handle(new GetTrialBalanceQuery(from, to));
        else if (_tab == 1)
            _journalBook = await JournalBookHandler.Handle(new GetJournalBookQuery(from, to));
        else
            _balanceSheet = await BalanceSheetHandler.Handle(new GetBalanceSheetQuery(to));

        _loading = false;
    }

    void ClearResults()
    {
        _trialBalance = null;
        _journalBook = null;
        _balanceSheet = null;
    }

    string PeriodLabel()
    {
        var from = _from?.ToString("dd/MM/yyyy") ?? "—";
        var to = _to?.ToString("dd/MM/yyyy") ?? "hoy";
        return $"{from} → {to}";
    }

    static string AccountTypeLabel(AccountType t) => t switch
    {
        AccountType.Asset => "Activo",
        AccountType.Liability => "Pasivo",
        AccountType.Equity => "Patrimonio",
        AccountType.Revenue => "Ingreso",
        AccountType.Expense => "Gasto",
        _ => t.ToString()
    };
}
