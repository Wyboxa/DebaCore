@page "/licencia"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Licencia — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Licencia</h1>
        <small class="text-muted">Estado de la licencia, plan activo y módulos contratados</small>
    </div>
</div>

<div class="row g-3">
    @foreach (var section in _sections)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="opacity: @(section.Available ? "1" : "0.6")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-wrap @section.IconClass" style="width:40px;height:40px;border-radius:10px;">
                            @((MarkupString)section.IconSvg)
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@section.Title</div>
                            @if (!section.Available)
                            {
                                <span class="badge bg-light text-secondary border" style="font-size:0.62rem">Próximamente</span>
                            }
                        </div>
                    </div>
                    <p class="small text-muted mb-0">@section.Description</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private record LicenseSection(string Title, string Description, string IconClass, string IconSvg, bool Available);

    private readonly LicenseSection[] _sections =
    [
        new("Estado de licencia",
            "Visualiza el plan activo, fecha de expiración, días restantes y estado de la licencia.",
            "icon-teal",
            "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z'/></svg>",
            false),

        new("Activar licencia",
            "Introduce la clave de licencia proporcionada para activar la plataforma en esta instalación.",
            "icon-teal",
            "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M0 8a4 4 0 0 1 7.465-2H14a.5.5 0 0 1 .354.146l1.5 1.5a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0L13 9.207l-.646.647a.5.5 0 0 1-.708 0L11 9.207l-.646.647a.5.5 0 0 1-.708 0L9 9.207l-.646.647A.5.5 0 0 1 8 10h-.535A4 4 0 0 1 0 8m4-3a3 3 0 1 0 2.712 4.285A.5.5 0 0 1 7.163 9h.63l.853-.854a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.793-.793-1-1h-6.63a.5.5 0 0 1-.451-.285A3 3 0 0 0 4 5'/><path d='M4 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0'/></svg>",
            false),

        new("Planes de suscripción",
            "Consulta los planes disponibles: Trial, Starter y Professional. Compara módulos y usuarios incluidos.",
            "icon-violet",
            "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M6 9a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3A.5.5 0 0 1 6 9m-1-4a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 5 5m2 2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 7 7m1 4a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5'/><path d='M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z'/></svg>",
            false),

        new("Módulos contratados",
            "Listado de módulos activos según la licencia. CRM, ERP, Contabilidad, Almacén, IA supervisada.",
            "icon-amber",
            "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm8 0A1.5 1.5 0 0 1 10.5 9h3A1.5 1.5 0 0 1 15 10.5v3A1.5 1.5 0 0 1 13.5 15h-3A1.5 1.5 0 0 1 9 13.5z'/></svg>",
            false),
    ];
}
