@page "/facturacion/compras/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetPurchaseInvoiceByIdHandler GetInvoice
@inject PostPurchaseInvoiceHandler PostHandler
@inject CancelPurchaseInvoiceHandler CancelHandler
@inject GetPayablesHandler GetPayables
@inject CreateSupplierPaymentHandler CreatePayment
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Factura compra — Debales</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_invoice is null)
{
    <div class="alert alert-warning">Factura no encontrada.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="GoBack">← Volver</button>
            <h1 class="h3 d-inline mb-0"><code>@_invoice.Number</code></h1>
            <span class="badge @StatusBadge(_invoice.Status) ms-2">@_invoice.StatusLabel</span>
            @if (!string.IsNullOrEmpty(_invoice.SupplierInvoiceNumber))
            {
                <small class="text-muted ms-2">(Fact. proveedor: @_invoice.SupplierInvoiceNumber)</small>
            }
        </div>
        <div class="d-flex gap-2">
            @if (_invoice.Status == PurchaseInvoiceStatus.Draft)
            {
                <button class="btn btn-success" disabled="@_busy" @onclick="PostInvoice">Contabilizar</button>
                <button class="btn btn-outline-danger" disabled="@_busy" @onclick="CancelInvoice">Cancelar</button>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Proveedor</div>
                <div class="fw-semibold">@_invoice.SupplierName</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Fecha</div>
                <div class="fw-semibold">@_invoice.Date.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Vencimiento</div>
                <div class="fw-semibold">@_invoice.DueDate.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Base imponible</div>
                <div class="fw-semibold">@_invoice.Subtotal.ToString("N2") €</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Total</div>
                <div class="fw-semibold fs-5">@_invoice.Total.ToString("N2") €</div>
            </div>
        </div>
    </div>

    <h5 class="mb-2">Líneas</h5>
    <div class="card border-0 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">P. unitario</th>
                        <th class="text-end">IVA %</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _invoice.Lines)
                    {
                        <tr>
                            <td class="text-muted">@l.SortOrder</td>
                            <td><code>@l.ItemCode</code></td>
                            <td>@(l.Description ?? l.ItemName)</td>
                            <td class="text-end">@l.Quantity.ToString("N2")</td>
                            <td class="text-end">@l.UnitPrice.ToString("N4") €</td>
                            <td class="text-end">@l.TaxRate.ToString("N0")%</td>
                            <td class="text-end">@l.LineSubtotal.ToString("N2") €</td>
                            <td class="text-end">@l.LineTaxAmount.ToString("N2") €</td>
                            <td class="text-end fw-semibold">@l.LineTotal.ToString("N2") €</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="6" class="text-end">Base / IVA / Total:</td>
                        <td class="text-end">@_invoice.Subtotal.ToString("N2") €</td>
                        <td class="text-end">@_invoice.TaxAmount.ToString("N2") €</td>
                        <td class="text-end">@_invoice.Total.ToString("N2") €</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    @if (_invoice.Status == PurchaseInvoiceStatus.Posted && _payables.Count > 0)
    {
        <h5 class="mb-2">Vencimientos de pago</h5>
        <div class="card border-0 shadow-sm mb-3">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Número</th>
                            <th>Vencimiento</th>
                            <th class="text-end">Importe</th>
                            <th class="text-end">Pagado</th>
                            <th class="text-end">Pendiente</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _payables)
                        {
                            <tr>
                                <td><code>@p.Number</code></td>
                                <td>@p.DueDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@p.OriginalAmount.ToString("N2") €</td>
                                <td class="text-end">@p.PaidAmount.ToString("N2") €</td>
                                <td class="text-end fw-semibold">@p.PendingAmount.ToString("N2") €</td>
                                <td><span class="badge @PayableBadge(p.Status)">@p.StatusLabel</span></td>
                                <td>
                                    @if (p.Status == PayableStatus.Pending || p.Status == PayableStatus.Partial)
                                    {
                                        <button class="btn btn-sm btn-outline-success"
                                                @onclick="() => OpenPayment(p.Id, p.PendingAmount)">
                                            Pagar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <div class="alert alert-danger py-2">@_actionError</div>
    }
}

@if (_showPaymentModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar pago</h5>
                    <button class="btn-close" @onclick="ClosePayment"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Fecha *</label>
                            <input type="date" class="form-control" @bind="_payForm.Date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Importe *</label>
                            <input type="number" step="0.01" class="form-control" @bind="_payForm.Amount" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Referencia</label>
                            <input class="form-control" @bind="_payForm.Reference" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_payError))
                    {
                        <div class="alert alert-danger py-2 mt-2">@_payError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePayment">Cancelar</button>
                    <button class="btn btn-success" disabled="@_busy" @onclick="SavePayment">Registrar pago</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    bool _loading = true;
    bool _busy;
    string? _actionError;
    PurchaseInvoiceDetailDto? _invoice;
    List<PayableSummaryDto> _payables = [];

    bool _showPaymentModal;
    string? _payError;
    Guid _payPayableId;
    PayForm _payForm = new();

    sealed class PayForm
    {
        public DateTime Date { get; set; } = DateTime.Today;
        public decimal Amount { get; set; }
        public string? Reference { get; set; }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        _invoice = await GetInvoice.Handle(new GetPurchaseInvoiceByIdQuery(Id));
        if (_invoice?.Status == PurchaseInvoiceStatus.Posted)
        {
            var p = await GetPayables.Handle(new GetPayablesQuery(null, null, null, 1, 50));
            _payables = p.Items.Where(x => x.PurchaseInvoiceId == Id).ToList();
        }
        _loading = false;
    }

    async Task PostInvoice()
    {
        _actionError = null; _busy = true;
        try
        {
            await PostHandler.Handle(new PostPurchaseInvoiceCommand(Id, "web"));
            Toast.Show("Factura contabilizada. Vencimiento creado.");
            await LoadAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busy = false; }
    }

    async Task CancelInvoice()
    {
        _actionError = null; _busy = true;
        try
        {
            await CancelHandler.Handle(new CancelPurchaseInvoiceCommand(Id, "web"));
            Toast.Show("Factura cancelada.");
            await LoadAsync();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _busy = false; }
    }

    void OpenPayment(Guid payableId, decimal pendingAmount)
    {
        _payPayableId = payableId;
        _payForm = new PayForm { Amount = pendingAmount };
        _payError = null;
        _showPaymentModal = true;
    }

    void ClosePayment() => _showPaymentModal = false;

    async Task SavePayment()
    {
        _payError = null; _busy = true;
        try
        {
            await CreatePayment.Handle(new CreateSupplierPaymentCommand(
                _invoice!.SupplierId, _payPayableId,
                DateOnly.FromDateTime(_payForm.Date),
                _payForm.Amount, _payForm.Reference, null, "web"));

            Toast.Show("Pago registrado.");
            _showPaymentModal = false;
            await LoadAsync();
        }
        catch (Exception ex) { _payError = ex.Message; }
        finally { _busy = false; }
    }

    void GoBack() => Nav.NavigateTo("/facturacion/compras");

    static string StatusBadge(PurchaseInvoiceStatus s) => s switch
    {
        PurchaseInvoiceStatus.Draft => "bg-secondary",
        PurchaseInvoiceStatus.Posted => "bg-success",
        PurchaseInvoiceStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    static string PayableBadge(PayableStatus s) => s switch
    {
        PayableStatus.Pending => "bg-warning text-dark",
        PayableStatus.Partial => "bg-info text-dark",
        PayableStatus.Settled => "bg-success",
        PayableStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}
