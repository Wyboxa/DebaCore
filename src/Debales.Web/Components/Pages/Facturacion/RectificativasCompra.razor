@page "/facturacion/rectificativas-compra"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetPurchaseCreditNotesHandler GetNotes
@inject CreatePurchaseCreditNoteHandler CreateHandler
@inject PostPurchaseCreditNoteHandler PostHandler
@inject GetPurchaseInvoicesHandler GetInvoices
@inject GetItemsHandler GetItems
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Rectificativas de compra — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Rectificativas de compra</h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nueva rectificativa</button>
</div>

<div class="mb-3 d-flex gap-2">
    <div class="input-group" style="max-width:340px">
        <input class="form-control" placeholder="Nº rectificativa o proveedor…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        <button class="btn btn-outline-secondary" @onclick="Search">Buscar</button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Proveedor</th>
                        <th>Factura original</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in _result.Items)
                    {
                        <tr style="cursor:pointer" @onclick="() => GoToNote(n.Id)">
                            <td><code>@n.Number</code></td>
                            <td>@n.SupplierName</td>
                            <td><code class="text-muted">@n.OriginalInvoiceNumber</code></td>
                            <td>@n.Date.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @StatusBadge(n.Status)">@n.StatusLabel</span></td>
                            <td class="text-end fw-semibold">@n.Total.ToString("N2") €</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick:stopPropagation="true"
                                        @onclick="() => GoToNote(n.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">@_result.TotalCount resultados</small>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!_result.HasPreviousPage)" @onclick="PrevPage">‹</button>
                <span class="btn btn-sm btn-outline-secondary disabled">@_page / @_result.TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!_result.HasNextPage)" @onclick="NextPage">›</button>
            </div>
        </div>
    }
}

@if (_showCreate)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva rectificativa de compra</h5>
                    <button class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Factura original (contabilizada) *</label>
                            <select class="form-select" @bind="_form.InvoiceIdStr">
                                <option value="">— Seleccionar factura —</option>
                                @foreach (var inv in _postedInvoices)
                                {
                                    <option value="@inv.Id">@inv.Number — @inv.SupplierName (@inv.Total.ToString("N2") €)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha *</label>
                            <input type="date" class="form-control" @bind="_form.Date" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Motivo</label>
                        <textarea class="form-control" rows="2" @bind="_form.Reason"></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-semibold mb-0">Líneas a rectificar</h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddLine">+ Línea</button>
                    </div>

                    @if (_formLines.Count > 0)
                    {
                        <div class="table-responsive mb-2">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Artículo</th>
                                        <th>Descripción</th>
                                        <th class="text-end" style="width:90px">Cantidad</th>
                                        <th class="text-end" style="width:110px">P. unitario</th>
                                        <th class="text-end" style="width:80px">IVA %</th>
                                        <th class="text-end" style="width:100px">Total</th>
                                        <th style="width:40px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _formLines.Count; i++)
                                    {
                                        var idx = i;
                                        var ln = _formLines[idx];
                                        <tr>
                                            <td>
                                                <select class="form-select form-select-sm" style="min-width:180px"
                                                        value="@ln.ItemIdStr"
                                                        @onchange="e => OnLineItemChanged(idx, e.Value?.ToString())">
                                                    <option value="">— Artículo —</option>
                                                    @foreach (var it in _catalogItems)
                                                    {
                                                        <option value="@it.Id">@it.Code – @it.Name</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input class="form-control form-control-sm" @bind="ln.Description" /></td>
                                            <td><input class="form-control form-control-sm text-end" type="number" step="0.01" min="0.01" @bind="ln.Quantity" /></td>
                                            <td><input class="form-control form-control-sm text-end" type="number" step="0.01" min="0" @bind="ln.UnitPrice" /></td>
                                            <td><input class="form-control form-control-sm text-end" type="number" step="0.01" min="0" @bind="ln.TaxRate" /></td>
                                            <td class="text-end fw-semibold">@LineTotal(ln).ToString("N2") €</td>
                                            <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(idx)">✕</button></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light fw-semibold">
                                        <td colspan="5" class="text-end">Total rectificativa:</td>
                                        <td class="text-end">@_formLines.Sum(LineTotal).ToString("N2") €</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger py-2">@_error</div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreate">Cancelar</button>
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="Save">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Crear rectificativa
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool _loading = true;
    bool _showCreate;
    bool _saving;
    string? _error;
    string? _search;
    int _page = 1;
    PagedResult<PurchaseCreditNoteSummaryDto>? _result;
    List<PurchaseInvoiceSummaryDto> _postedInvoices = [];
    List<ItemSummaryDto> _catalogItems = [];
    CreateForm _form = new();
    List<FormLine> _formLines = [];

    sealed class CreateForm
    {
        public string InvoiceIdStr { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Today;
        public string? Reason { get; set; }
    }

    sealed class FormLine
    {
        public string ItemIdStr { get; set; } = "";
        public string? Description { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal TaxRate { get; set; } = 21;
    }

    static decimal LineTotal(FormLine l) => l.Quantity * l.UnitPrice * (1 + l.TaxRate / 100m);

    protected override async Task OnInitializedAsync()
    {
        var invoicesResult = await GetInvoices.Handle(
            new GetPurchaseInvoicesQuery(null, null, PurchaseInvoiceStatus.Posted, 1, 500));
        _postedInvoices = invoicesResult.Items.ToList();
        var itemsResult = await GetItems.Handle(new GetItemsQuery(null, null, null, 1, 500));
        _catalogItems = itemsResult.Items.ToList();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _result = await GetNotes.Handle(new GetPurchaseCreditNotesQuery(_search, null, _page, 20));
        _loading = false;
    }

    async Task OpenCreate()
    {
        _form = new CreateForm();
        _formLines = [];
        _error = null;
        _showCreate = true;
    }

    void CloseCreate() => _showCreate = false;
    void AddLine() => _formLines.Add(new FormLine());
    void RemoveLine(int idx) => _formLines.RemoveAt(idx);

    void OnLineItemChanged(int idx, string? val)
    {
        _formLines[idx].ItemIdStr = val ?? "";
        if (Guid.TryParse(val, out var itemId))
        {
            var item = _catalogItems.FirstOrDefault(i => i.Id == itemId);
            if (item is not null)
                _formLines[idx].UnitPrice = item.SalePrice;
        }
    }

    async Task Save()
    {
        _error = null;
        if (!Guid.TryParse(_form.InvoiceIdStr, out var invoiceId))
        { _error = "Selecciona la factura original."; return; }
        if (_formLines.Count == 0)
        { _error = "Añade al menos una línea."; return; }
        if (_formLines.Any(l => !Guid.TryParse(l.ItemIdStr, out _)))
        { _error = "Todas las líneas deben tener un artículo seleccionado."; return; }

        var invoice = _postedInvoices.First(i => i.Id == invoiceId);
        _saving = true;
        try
        {
            var lines = _formLines.Select(l => new CreatePurchaseCreditNoteLineRequest(
                Guid.Parse(l.ItemIdStr), l.Description, l.Quantity, l.UnitPrice, l.TaxRate)).ToList();

            await CreateHandler.Handle(new CreatePurchaseCreditNoteCommand(
                invoice.SupplierId, invoiceId,
                DateOnly.FromDateTime(_form.Date),
                _form.Reason, lines, "web"));

            Toast.Show("Rectificativa de compra creada correctamente.");
            _showCreate = false;
            _page = 1;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    void GoToNote(Guid id) => Nav.NavigateTo($"/facturacion/rectificativas-compra/{id}");

    async Task Search() { _page = 1; await LoadAsync(); }
    async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    async Task PrevPage() { _page--; await LoadAsync(); }
    async Task NextPage() { _page++; await LoadAsync(); }

    static string StatusBadge(PurchaseCreditNoteStatus s) => s switch
    {
        PurchaseCreditNoteStatus.Draft => "bg-secondary",
        PurchaseCreditNoteStatus.Posted => "bg-success",
        PurchaseCreditNoteStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}
