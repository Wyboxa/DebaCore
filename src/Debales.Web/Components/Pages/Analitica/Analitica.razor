@page "/analitica"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetCustomersHandler GetCustomers
@inject GetSalesOrdersHandler GetSalesOrders
@inject GetSalesInvoicesHandler GetSalesInvoices
@inject GetPurchaseInvoicesHandler GetPurchaseInvoices
@inject GetPurchaseOrdersHandler GetPurchaseOrders
@inject GetReceivablesHandler GetReceivables
@inject GetSalesQuotesHandler GetSalesQuotes
@inject NavigationManager Nav

<PageTitle>Analítica — Debales</PageTitle>

<ModuleRequired Module="Analytics">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Analítica</h1>
        <small class="text-muted">Resumen ejecutivo y métricas clave del negocio</small>
    </div>
    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">
        Datos en tiempo real
    </span>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <!-- Fila 1: KPIs ejecutivos -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h3 fw-bold mb-0">@_activeCustomers</div>
                            <div class="small text-muted">Clientes activos</div>
                        </div>
                        <div class="rounded-2 p-2 bg-success bg-opacity-10 text-success">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h3 fw-bold mb-0">@_totalOrders</div>
                            <div class="small text-muted">Pedidos venta</div>
                            <div class="small text-primary mt-1">@_pendingOrders pendientes</div>
                        </div>
                        <div class="rounded-2 p-2 bg-primary bg-opacity-10 text-primary">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h3 fw-bold mb-0">@_invoiceRevenue.ToString("N0") €</div>
                            <div class="small text-muted">Facturado venta</div>
                            <div class="small text-muted mt-1">@_postedInvoices facturas</div>
                        </div>
                        <div class="rounded-2 p-2 bg-warning bg-opacity-10 text-warning">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h3 fw-bold mb-0">@_purchaseRevenue.ToString("N0") €</div>
                            <div class="small text-muted">Facturado compra</div>
                            <div class="small text-muted mt-1">@_postedPurchaseInvoices facturas</div>
                        </div>
                        <div class="rounded-2 p-2 bg-info bg-opacity-10 text-info">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm h-100 @(_overdueAmount > 0 ? "border border-danger border-opacity-25" : "")">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h3 fw-bold mb-0 @(_overdueAmount > 0 ? "text-danger" : "")">@_pendingReceivables.ToString("N0") €</div>
                            <div class="small text-muted">Pendiente cobro</div>
                            @if (_overdueAmount > 0)
                            {
                                <div class="small text-danger mt-1">@_overdueAmount.ToString("N0") € vencido</div>
                            }
                        </div>
                        <div class="rounded-2 p-2 @(_overdueAmount > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-secondary bg-opacity-10 text-secondary")">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="h3 fw-bold mb-0">@_quoteConversionPct%</div>
                            <div class="small text-muted">Conversión presup.</div>
                            <div class="small text-muted mt-1">@_quotesConverted / @_quotesSent enviados</div>
                        </div>
                        <div class="rounded-2 p-2 bg-success bg-opacity-10 text-success">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2zM5 8.5a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zm0-2a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1zm0-2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2: Evolución mensual -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 fw-semibold">
                    Evolución mensual — últimos 6 meses (facturas contabilizadas)
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mes</th>
                                <th class="text-end">Facturación venta</th>
                                <th class="text-end">Facturación compra</th>
                                <th class="text-end pe-3">Diferencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _monthlyStats)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold small">@m.Month</td>
                                    <td class="text-end small">@m.SalesTotal.ToString("N2") €</td>
                                    <td class="text-end small">@m.PurchaseTotal.ToString("N2") €</td>
                                    <td class="text-end pe-3 fw-semibold small @(m.Difference >= 0 ? "text-success" : "text-danger")">
                                        @(m.Difference >= 0 ? "+" : "")@m.Difference.ToString("N2") €
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td class="ps-3 small">Total</td>
                                <td class="text-end small">@_monthlyStats.Sum(m => m.SalesTotal).ToString("N2") €</td>
                                <td class="text-end small">@_monthlyStats.Sum(m => m.PurchaseTotal).ToString("N2") €</td>
                                <td class="text-end pe-3 small @(_monthlyStats.Sum(m => m.Difference) >= 0 ? "text-success" : "text-danger")">
                                    @{ var totalDiff = _monthlyStats.Sum(m => m.Difference); }
                                    @(totalDiff >= 0 ? "+" : "")@totalDiff.ToString("N2") €
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 3: Top clientes + Top proveedores -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3 fw-semibold">
                    Top 5 clientes por volumen de pedidos
                </div>
                @if (_topCustomers.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Sin datos suficientes.</div>
                }
                else
                {
                    <div class="card-body p-0">
                        @{ var maxSales = _topCustomers.Max(c => c.Total); }
                        @foreach (var (name, count, total) in _topCustomers)
                        {
                            var pct = maxSales > 0 ? (int)(total / maxSales * 100) : 0;
                            <div class="px-3 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold">@name</span>
                                    <span class="small text-muted">@count ped. · @total.ToString("N0") €</span>
                                </div>
                                <div class="progress" style="height:4px">
                                    <div class="progress-bar" style="width:@pct%;background:#6B9CA9"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3 fw-semibold">
                    Top 5 proveedores por volumen de compras
                </div>
                @if (_topSuppliers.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Sin datos suficientes.</div>
                }
                else
                {
                    <div class="card-body p-0">
                        @{ var maxPurchase = _topSuppliers.Max(s => s.Total); }
                        @foreach (var (name, count, total) in _topSuppliers)
                        {
                            var pct = maxPurchase > 0 ? (int)(total / maxPurchase * 100) : 0;
                            <div class="px-3 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold">@name</span>
                                    <span class="small text-muted">@count ped. · @total.ToString("N0") €</span>
                                </div>
                                <div class="progress" style="height:4px">
                                    <div class="progress-bar bg-info" style="width:@pct%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Fila 4: Conversión presupuestos + Últimas facturas -->
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3 fw-semibold">
                    Presupuestos — tasa de conversión
                </div>
                <div class="card-body">
                    @if (_quotesSent == 0)
                    {
                        <div class="text-muted text-center py-3 small">Sin presupuestos enviados.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">Conversión</span>
                                <span class="fw-bold @(_quoteConversionPct >= 50 ? "text-success" : "text-warning")">@_quoteConversionPct%</span>
                            </div>
                            <div class="progress" style="height:8px">
                                <div class="progress-bar @(_quoteConversionPct >= 50 ? "bg-success" : "bg-warning")"
                                     style="width:@_quoteConversionPct%"></div>
                            </div>
                        </div>
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="fw-bold">@_quotesTotal</div>
                                <div class="small text-muted">Total</div>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold">@_quotesSent</div>
                                <div class="small text-muted">Enviados</div>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-success">@_quotesConverted</div>
                                <div class="small text-muted">Convertidos</div>
                            </div>
                        </div>
                        @if (_quotesPending > 0)
                        {
                            <div class="alert alert-warning py-2 px-3 small mt-3 mb-0">
                                @_quotesPending presupuesto@(_quotesPending != 1 ? "s" : "") pendiente@(_quotesPending != 1 ? "s" : "") de respuesta
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Últimas facturas de venta</span>
                    <a href="/facturacion/ventas" class="btn btn-sm btn-outline-primary" style="font-size:.8rem">Ver todas</a>
                </div>
                @if (_recentInvoices.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Sin facturas registradas.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Número</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th class="text-end pe-3">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in _recentInvoices)
                                {
                                    <tr style="cursor:pointer" @onclick="() => GoToInvoice(inv.Id)">
                                        <td class="ps-3 font-monospace small">@inv.Number</td>
                                        <td class="small">@inv.CustomerName</td>
                                        <td class="small text-muted">@inv.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end pe-3 small fw-semibold">@inv.Total.ToString("N2") €</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}
</ModuleRequired>

@code {
    bool _loading = true;

    int _activeCustomers, _totalOrders, _pendingOrders, _postedInvoices, _postedPurchaseInvoices;
    int _quotesTotal, _quotesSent, _quotesConverted, _quotesPending, _quoteConversionPct;
    decimal _invoiceRevenue, _purchaseRevenue, _pendingReceivables, _overdueAmount;

    List<MonthStat> _monthlyStats = [];
    List<(string Name, int Count, decimal Total)> _topCustomers = [];
    List<(string Name, int Count, decimal Total)> _topSuppliers = [];
    List<SalesInvoiceSummaryDto> _recentInvoices = [];

    sealed record MonthStat(string Month, decimal SalesTotal, decimal PurchaseTotal)
    {
        public decimal Difference => SalesTotal - PurchaseTotal;
    }

    protected override async Task OnInitializedAsync()
    {
        var culture = new System.Globalization.CultureInfo("es-ES");
        var today = DateOnly.FromDateTime(DateTime.Today);

        var customersTask = GetCustomers.Handle(new GetCustomersQuery(null, 1, 500));
        var salesOrdersTask = GetSalesOrders.Handle(new GetSalesOrdersQuery(null, null, null, 1, 500));
        var salesInvoicesTask = GetSalesInvoices.Handle(new GetSalesInvoicesQuery(null, null, null, 1, 500));
        var purchaseInvoicesTask = GetPurchaseInvoices.Handle(new GetPurchaseInvoicesQuery(null, null, null, 1, 500));
        var purchaseOrdersTask = GetPurchaseOrders.Handle(new GetPurchaseOrdersQuery(null, null, null, 1, 500));
        var receivablesTask = GetReceivables.Handle(new GetReceivablesQuery(null, null, null, 1, 500));
        var quotesTask = GetSalesQuotes.Handle(new GetSalesQuotesQuery(null, null, null, 1, 500));

        await Task.WhenAll(customersTask, salesOrdersTask, salesInvoicesTask,
            purchaseInvoicesTask, purchaseOrdersTask, receivablesTask, quotesTask);

        // Clientes
        _activeCustomers = customersTask.Result.Items.Count(c => c.IsActive);

        // Pedidos venta
        var orders = salesOrdersTask.Result.Items;
        _totalOrders = orders.Count;
        _pendingOrders = orders.Count(o =>
            o.Status == SalesOrderStatus.Confirmed || o.Status == SalesOrderStatus.PartiallyDelivered);

        // Facturas venta
        var allSalesInvoices = salesInvoicesTask.Result.Items;
        var postedSales = allSalesInvoices.Where(i => i.Status == SalesInvoiceStatus.Posted).ToList();
        _postedInvoices = postedSales.Count;
        _invoiceRevenue = postedSales.Sum(i => i.Total);
        _recentInvoices = allSalesInvoices.OrderByDescending(i => i.Date).Take(10).ToList();

        // Facturas compra
        var allPurchaseInvoices = purchaseInvoicesTask.Result.Items;
        var postedPurchase = allPurchaseInvoices
            .Where(i => i.Status == PurchaseInvoiceStatus.Posted).ToList();
        _postedPurchaseInvoices = postedPurchase.Count;
        _purchaseRevenue = postedPurchase.Sum(i => i.Total);

        // Evolución mensual (últimos 6 meses)
        _monthlyStats = Enumerable.Range(0, 6)
            .Select(i => today.AddMonths(-5 + i))
            .Select(m =>
            {
                var salesTotal = postedSales
                    .Where(inv => inv.Date.Year == m.Year && inv.Date.Month == m.Month)
                    .Sum(inv => inv.Total);
                var purchaseTotal = postedPurchase
                    .Where(inv => inv.Date.Year == m.Year && inv.Date.Month == m.Month)
                    .Sum(inv => inv.Total);
                var label = new DateOnly(m.Year, m.Month, 1).ToString("MMM yyyy", culture);
                return new MonthStat(label, salesTotal, purchaseTotal);
            })
            .ToList();

        // Top clientes por pedidos
        _topCustomers = orders
            .GroupBy(o => o.CustomerName)
            .Select(g => (Name: g.Key, Count: g.Count(), Total: g.Sum(o => o.Total)))
            .OrderByDescending(x => x.Total)
            .Take(5)
            .ToList();

        // Top proveedores por pedidos de compra
        var purchaseOrders = purchaseOrdersTask.Result.Items;
        _topSuppliers = purchaseOrders
            .GroupBy(o => o.SupplierName)
            .Select(g => (Name: g.Key, Count: g.Count(), Total: g.Sum(o => o.Total)))
            .OrderByDescending(x => x.Total)
            .Take(5)
            .ToList();

        // Cobros
        var receivables = receivablesTask.Result.Items
            .Where(r => r.Status == ReceivableStatus.Pending || r.Status == ReceivableStatus.Partial)
            .ToList();
        _pendingReceivables = receivables.Sum(r => r.PendingAmount);
        _overdueAmount = receivables.Where(r => r.DueDate < today).Sum(r => r.PendingAmount);

        // Presupuestos
        var quotes = quotesTask.Result.Items;
        _quotesTotal = quotes.Count;
        _quotesSent = quotes.Count(q =>
            q.Status == SalesQuoteStatus.Sent ||
            q.Status == SalesQuoteStatus.Accepted ||
            q.ConvertedToOrderId.HasValue);
        _quotesConverted = quotes.Count(q => q.ConvertedToOrderId.HasValue);
        _quotesPending = quotes.Count(q => q.Status == SalesQuoteStatus.Sent);
        _quoteConversionPct = _quotesSent > 0
            ? (int)Math.Round(_quotesConverted * 100.0 / _quotesSent)
            : 0;

        _loading = false;
    }

    void GoToInvoice(Guid id) => Nav.NavigateTo($"/facturacion/ventas/{id}");
}
