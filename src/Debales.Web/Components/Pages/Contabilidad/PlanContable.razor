@page "/contabilidad/plan"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetAccountsHandler GetAccounts
@inject CreateAccountHandler CreateHandler
@inject ToastService Toast

<PageTitle>Plan Contable — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Plan Contable <small class="text-muted fs-6">(PGC España)</small></h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nueva cuenta</button>
</div>

<div class="mb-3">
    <div class="input-group" style="max-width:400px">
        <input class="form-control" placeholder="Buscar por código o nombre…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        <button class="btn btn-outline-secondary" @onclick="Search">Buscar</button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Imputable</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in _result.Items)
                    {
                        <tr>
                            <td><code>@a.Code</code></td>
                            <td>@a.Name</td>
                            <td><span class="badge @TypeBadge(a.Type)">@a.TypeLabel</span></td>
                            <td>
                                @if (a.IsPostable)
                                {
                                    <span class="text-success">Sí</span>
                                }
                                else
                                {
                                    <span class="text-muted">No</span>
                                }
                            </td>
                            <td>
                                @if (a.IsActive)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiva</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_result.Items.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron cuentas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(_result.HasPreviousPage ? "" : "disabled")">
                    <button class="page-link" @onclick="PrevPage">Anterior</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @_result.Page de @_result.TotalPages (@_result.TotalCount total)</span>
                </li>
                <li class="page-item @(_result.HasNextPage ? "" : "disabled")">
                    <button class="page-link" @onclick="NextPage">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (_showCreate)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva cuenta contable</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_form" OnValidSubmit="CreateAccount">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Código *</label>
                                <InputText class="form-control" @bind-Value="_form.Code" placeholder="Ej: 4300001" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="_form.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo *</label>
                                <InputSelect class="form-select" @bind-Value="_form.Type">
                                    <option value="@AccountType.Asset">Activo</option>
                                    <option value="@AccountType.Liability">Pasivo</option>
                                    <option value="@AccountType.Equity">Patrimonio</option>
                                    <option value="@AccountType.Revenue">Ingreso</option>
                                    <option value="@AccountType.Expense">Gasto</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Código padre</label>
                                <InputText class="form-control" @bind-Value="_form.ParentCode" placeholder="Ej: 430" />
                            </div>
                            <div class="col-12">
                                <div class="form-check mt-1">
                                    <InputCheckbox class="form-check-input" @bind-Value="_form.IsPostable" id="isPostable" />
                                    <label class="form-check-label" for="isPostable">Cuenta imputable (admite movimientos)</label>
                                </div>
                            </div>
                        </div>
                        @if (_createError is not null)
                        {
                            <div class="alert alert-danger mt-2">@_createError</div>
                        }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreate">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">
                                @(_saving ? "Guardando…" : "Crear cuenta")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<AccountSummaryDto>? _result;
    private string? _search;
    private int _page = 1;
    private bool _loading;
    private bool _showCreate;
    private bool _saving;
    private string? _createError;
    private AccountForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _result = await GetAccounts.Handle(new GetAccountsQuery(_search, _page, 50));
        _loading = false;
    }

    private async Task Search() { _page = 1; await LoadAsync(); }
    private async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private void OpenCreate() { _form = new(); _createError = null; _showCreate = true; }
    private void CloseCreate() => _showCreate = false;

    private async Task CreateAccount()
    {
        _saving = true;
        _createError = null;
        try
        {
            await CreateHandler.Handle(
                new CreateAccountCommand(_form.Code!, _form.Name!, _form.Type, _form.IsPostable, _form.ParentCode, "web"));
            _showCreate = false;
            Toast.Show("Cuenta creada correctamente");
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { _createError = ex.Message; }
        catch (ArgumentException ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    private static string TypeBadge(AccountType t) => t switch
    {
        AccountType.Asset => "bg-primary",
        AccountType.Liability => "bg-warning text-dark",
        AccountType.Equity => "bg-info text-dark",
        AccountType.Revenue => "bg-success",
        AccountType.Expense => "bg-danger",
        _ => "bg-secondary"
    };

    private sealed class AccountForm
    {
        public string? Code { get; set; }
        public string? Name { get; set; }
        public AccountType Type { get; set; } = AccountType.Asset;
        public bool IsPostable { get; set; } = true;
        public string? ParentCode { get; set; }
    }
}
