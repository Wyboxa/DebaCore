@page "/licencia"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetCurrentLicenseHandler GetCurrentLicense
@inject GetSubscriptionPlansHandler GetPlans
@inject ActivateLicenseHandler ActivateHandler
@inject ToastService Toast

<PageTitle>Licencia — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Licencia</h1>
        <small class="text-muted">Estado de la licencia y plan activo</small>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_license is null)
{
    <div class="row g-4">
        <div class="col-12">
            <div class="alert alert-warning d-flex align-items-center gap-3">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                    <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                </svg>
                <div>
                    <strong>Sin licencia activa.</strong>
                    Introduce una clave para activar la plataforma.
                </div>
            </div>
        </div>

        @if (_plans.Count > 0)
        {
            <div class="col-12">
                <h5 class="mb-3">Planes disponibles</h5>
                <div class="row g-3">
                    @foreach (var plan in _plans)
                    {
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-1">@plan.Name</h6>
                                    <p class="text-muted small mb-2">@plan.Description</p>
                                    <ul class="list-unstyled small mb-3">
                                        <li>Hasta <strong>@(plan.MaxUsers == 0 ? "∞" : plan.MaxUsers.ToString())</strong> usuarios</li>
                                        <li>Hasta <strong>@(plan.MaxModules >= 99 ? "todos" : plan.MaxModules.ToString())</strong> módulos</li>
                                        <li>IA: <strong>@(plan.AllowsAI ? "Incluida" : "No incluida")</strong></li>
                                    </ul>
                                    <div class="fw-bold fs-5">
                                        @(plan.PriceMonthly == 0 ? "Gratuito" : $"{plan.PriceMonthly:N0} €/mes")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header fw-semibold">Activar licencia</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Clave de licencia *</label>
                            <input class="form-control font-monospace" placeholder="DEBALES-XXXX-XXXX-XXXX"
                                   @bind="_activateForm.LicenseKey" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Empresa *</label>
                            <input class="form-control" placeholder="Nombre de la empresa"
                                   @bind="_activateForm.LicenseeCompany" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email de contacto *</label>
                            <input type="email" class="form-control" @bind="_activateForm.LicenseeEmail" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Plan *</label>
                            <select class="form-select" @bind="_activateForm.PlanCode">
                                <option value="">— Seleccionar —</option>
                                @foreach (var p in _plans)
                                {
                                    <option value="@p.Code">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha inicio</label>
                            <input type="date" class="form-control" @bind="_activateForm.StartsAt" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha expiración</label>
                            <input type="date" class="form-control" @bind="_activateForm.ExpiresAt" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_activateError))
                    {
                        <div class="alert alert-danger py-2 mt-3">@_activateError</div>
                    }
                    <div class="mt-3">
                        <button class="btn btn-primary" disabled="@_saving" @onclick="Activate">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Activar licencia
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Estado</div>
                <div>
                    <span class="badge fs-6 @LicenseBadge(_license.Status)">@_license.Status</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Plan</div>
                <div class="fw-semibold">@_license.Plan.Name</div>
                <small class="text-muted">@_license.Plan.Code</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Empresa</div>
                <div class="fw-semibold">@_license.LicenseeCompany</div>
                <small class="text-muted">@_license.LicenseeEmail</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 @(_license.DaysRemaining < 15 ? "border border-warning" : "")">
                <div class="text-muted small mb-1">Vence</div>
                <div class="fw-semibold @(_license.DaysRemaining < 15 ? "text-warning" : "")">
                    @_license.ExpiresAt.ToString("dd/MM/yyyy")
                </div>
                <small class="@(_license.DaysRemaining < 15 ? "text-warning" : "text-muted")">
                    @_license.DaysRemaining días restantes
                </small>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Clave</div>
                <div class="fw-semibold font-monospace small">@_license.LicenseKey</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Vigencia</div>
                <div class="fw-semibold">
                    @_license.StartsAt.ToString("dd/MM/yyyy") — @_license.ExpiresAt.ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">IA</div>
                <div class="fw-semibold">@(_license.Plan.AllowsAI ? "Incluida" : "No incluida")</div>
            </div>
        </div>
    </div>

    @if (_license.Modules.Count > 0)
    {
        <h5 class="mb-3">Módulos contratados</h5>
        <div class="row g-2 mb-4">
            @foreach (var m in _license.Modules.OrderBy(x => x.ModuleCode))
            {
                <div class="col-auto">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        @m.ModuleCode
                    </span>
                </div>
            }
        </div>
    }

    @if (!_license.IsValid)
    {
        <div class="alert alert-danger">
            La licencia no está activa. Contacta con tu proveedor para renovarla.
        </div>
    }

    <div class="mt-3">
        <h5 class="mb-3">Planes disponibles</h5>
        <div class="row g-3">
            @foreach (var plan in _plans)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100 @(_license.Plan.Code == plan.Code ? "border border-primary" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 class="fw-bold mb-0">@plan.Name</h6>
                                @if (_license.Plan.Code == plan.Code)
                                { <span class="badge bg-primary">Activo</span> }
                            </div>
                            <p class="text-muted small mb-2">@plan.Description</p>
                            <ul class="list-unstyled small mb-3">
                                <li>Hasta <strong>@(plan.MaxUsers == 0 ? "∞" : plan.MaxUsers.ToString())</strong> usuarios</li>
                                <li>Hasta <strong>@(plan.MaxModules >= 99 ? "todos" : plan.MaxModules.ToString())</strong> módulos</li>
                                <li>IA: <strong>@(plan.AllowsAI ? "Incluida" : "No incluida")</strong></li>
                            </ul>
                            <div class="fw-bold">
                                @(plan.PriceMonthly == 0 ? "Gratuito" : $"{plan.PriceMonthly:N0} €/mes")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    bool _loading = true;
    bool _saving;
    string? _activateError;
    LicenseSummaryDto? _license;
    List<SubscriptionPlanDto> _plans = [];

    ActivateForm _activateForm = new();

    sealed class ActivateForm
    {
        public string LicenseKey { get; set; } = "";
        public string LicenseeCompany { get; set; } = "";
        public string LicenseeEmail { get; set; } = "";
        public string PlanCode { get; set; } = "";
        public DateTime StartsAt { get; set; } = DateTime.Today;
        public DateTime ExpiresAt { get; set; } = DateTime.Today.AddDays(30);
    }

    protected override async Task OnInitializedAsync()
    {
        _plans = await GetPlans.Handle();
        _license = await GetCurrentLicense.Handle();
        _loading = false;
    }

    async Task Activate()
    {
        _activateError = null;
        if (string.IsNullOrWhiteSpace(_activateForm.LicenseKey))
        { _activateError = "Introduce la clave de licencia."; return; }
        if (string.IsNullOrWhiteSpace(_activateForm.LicenseeCompany))
        { _activateError = "Introduce el nombre de la empresa."; return; }
        if (string.IsNullOrWhiteSpace(_activateForm.PlanCode))
        { _activateError = "Selecciona un plan."; return; }

        _saving = true;
        try
        {
            _license = await ActivateHandler.Handle(new ActivateLicenseCommand(
                _activateForm.LicenseKey.Trim().ToUpper(),
                Environment.MachineName,
                _activateForm.LicenseeCompany,
                _activateForm.LicenseeEmail,
                _activateForm.PlanCode,
                _activateForm.StartsAt,
                _activateForm.ExpiresAt,
                [],
                "web"));
            Toast.Show("Licencia activada correctamente.");
        }
        catch (Exception ex) { _activateError = ex.Message; }
        finally { _saving = false; }
    }

    static string LicenseBadge(LicenseStatus s) => s switch
    {
        LicenseStatus.Active => "bg-success",
        LicenseStatus.Trial => "bg-info text-dark",
        LicenseStatus.Expired => "bg-danger",
        LicenseStatus.Suspended => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
