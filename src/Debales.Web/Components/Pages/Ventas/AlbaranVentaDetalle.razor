@page "/ventas/albaranes/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetSalesDeliveryNoteByIdHandler GetNote
@inject PostSalesDeliveryNoteHandler PostHandler
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Albarán venta — Debales</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_note is null)
{
    <div class="alert alert-warning">Albarán no encontrado.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="GoBack">← Volver</button>
            <h1 class="h3 d-inline mb-0"><code>@_note.Number</code></h1>
            <span class="badge @StatusBadge(_note.Status) ms-2">@_note.StatusLabel</span>
        </div>
        @if (_note.Status == SalesDeliveryNoteStatus.Draft)
        {
            <button class="btn btn-success" disabled="@_busy" @onclick="PostNote">Emitir albarán</button>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Cliente</div>
                <div class="fw-semibold">@_note.CustomerName</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small mb-1">Fecha</div>
                <div class="fw-semibold">@_note.Date.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
        @if (_note.SalesOrderNumber is not null)
        {
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3">
                    <div class="text-muted small mb-1">Pedido origen</div>
                    <div class="fw-semibold"><code>@_note.SalesOrderNumber</code></div>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_note.Notes))
    {
        <div class="alert alert-light border mb-3">@_note.Notes</div>
    }

    <h5 class="mb-2">Líneas</h5>
    <div class="card border-0 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Código</th>
                        <th>Artículo</th>
                        <th>Descripción</th>
                        <th class="text-end">Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _note.Lines)
                    {
                        <tr>
                            <td class="text-muted">@l.SortOrder</td>
                            <td><code>@l.ItemCode</code></td>
                            <td>@l.ItemName</td>
                            <td class="text-muted">@(l.Description ?? "—")</td>
                            <td class="text-end fw-semibold">@l.Quantity.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-muted small">
        Creado: @_note.CreatedAt.ToString("dd/MM/yyyy HH:mm") por @(_note.CreatedBy ?? "—")
        @if (_note.UpdatedAt.HasValue)
        {
            <span class="ms-3">Modificado: @_note.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2 mt-3">@_error</div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    bool _loading = true;
    bool _busy;
    string? _error;
    SalesDeliveryNoteDetailDto? _note;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        _note = await GetNote.Handle(new GetSalesDeliveryNoteByIdQuery(Id));
        _loading = false;
    }

    async Task PostNote()
    {
        _error = null; _busy = true;
        try
        {
            await PostHandler.Handle(new PostSalesDeliveryNoteCommand(Id, "web"));
            Toast.Show("Albarán emitido correctamente.");
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    void GoBack() => Nav.NavigateTo("/ventas/albaranes");

    static string StatusBadge(SalesDeliveryNoteStatus s) => s switch
    {
        SalesDeliveryNoteStatus.Draft => "bg-secondary",
        SalesDeliveryNoteStatus.Posted => "bg-success",
        SalesDeliveryNoteStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}
