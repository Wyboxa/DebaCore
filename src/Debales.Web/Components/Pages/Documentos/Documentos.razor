@page "/documentos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetDocumentsHandler GetDocuments
@inject GetDocumentTypesHandler GetDocumentTypes
@inject CreateDocumentHandler CreateHandler
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Documentos — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Documentos</h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nuevo documento</button>
</div>

<div class="mb-3 row g-2">
    <div class="col-md-4">
        <div class="input-group">
            <input class="form-control" placeholder="Buscar por título o archivo…"
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
            <button class="btn btn-outline-secondary" @onclick="Search">Buscar</button>
        </div>
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="_filterTypeId" @bind:after="Search">
            <option value="">Todos los tipos</option>
            @foreach (var t in _types)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Tipo</th>
                        <th>Archivo</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _result.Items)
                    {
                        <tr style="cursor:pointer" @onclick="() => GoToDetail(d.Id)">
                            <td><strong>@d.Title</strong>
                                @if (d.Description is not null)
                                {
                                    <div class="text-muted small">@d.Description</div>
                                }
                            </td>
                            <td><span class="badge bg-info text-dark">@d.DocumentTypeName</span></td>
                            <td>@(d.FileName ?? "—")</td>
                            <td>@d.DocumentDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (d.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => GoToDetail(d.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                    @if (!_result.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron documentos.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(_result.HasPreviousPage ? "" : "disabled")">
                    <button class="page-link" @onclick="PrevPage">Anterior</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @_result.Page de @_result.TotalPages (@_result.TotalCount total)</span>
                </li>
                <li class="page-item @(_result.HasNextPage ? "" : "disabled")">
                    <button class="page-link" @onclick="NextPage">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (_showCreate)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo documento</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_form" OnValidSubmit="CreateDocument">
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Título *</label>
                                <InputText class="form-control" @bind-Value="_form.Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo *</label>
                                <InputSelect class="form-select" @bind-Value="_form.DocumentTypeId">
                                    <option value="">— Seleccionar tipo —</option>
                                    @foreach (var t in _types)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha del documento *</label>
                                <InputDate class="form-control" @bind-Value="_form.DocumentDate" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <InputTextArea class="form-control" @bind-Value="_form.Description" rows="2" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Nombre de archivo</label>
                                <InputText class="form-control" @bind-Value="_form.FileName" placeholder="contrato_2026.pdf" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tipo MIME</label>
                                <InputText class="form-control" @bind-Value="_form.MimeType" placeholder="application/pdf" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notas internas</label>
                                <InputTextArea class="form-control" @bind-Value="_form.Notes" rows="2" />
                            </div>
                        </div>
                        @if (_createError is not null)
                        {
                            <div class="alert alert-danger mt-2">@_createError</div>
                        }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreate">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">
                                @(_saving ? "Guardando…" : "Crear documento")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<DocumentDto>? _result;
    private IReadOnlyList<DocumentTypeDto> _types = [];
    private string? _search;
    private string? _filterTypeId;
    private int _page = 1;
    private bool _loading;
    private bool _showCreate;
    private bool _saving;
    private string? _createError;
    private DocumentForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _types = await GetDocumentTypes.Handle();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        Guid? typeId = Guid.TryParse(_filterTypeId, out var g) ? g : null;
        _result = await GetDocuments.Handle(new GetDocumentsQuery(_search, typeId, null, null, _page, 20));
        _loading = false;
    }

    private async Task Search() { _page = 1; await LoadAsync(); }
    private async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
    private void GoToDetail(Guid id) => Nav.NavigateTo($"/documentos/{id}");

    private void OpenCreate() { _form = new() { DocumentDate = DateTime.Today }; _createError = null; _showCreate = true; }
    private void CloseCreate() => _showCreate = false;

    private async Task CreateDocument()
    {
        if (string.IsNullOrWhiteSpace(_form.Title)) { _createError = "El título es obligatorio."; return; }
        if (!Guid.TryParse(_form.DocumentTypeId, out var typeId)) { _createError = "Selecciona un tipo de documento."; return; }

        _saving = true;
        _createError = null;
        try
        {
            var doc = await CreateHandler.Handle(
                new CreateDocumentCommand(
                    _form.Title!, _form.Description, typeId,
                    null, null,
                    _form.FileName, null, _form.MimeType,
                    _form.Notes, _form.DocumentDate, "web"));
            _showCreate = false;
            Toast.Show("Documento creado correctamente");
            Nav.NavigateTo($"/documentos/{doc.Id}");
        }
        catch (KeyNotFoundException ex) { _createError = ex.Message; }
        catch (ArgumentException ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    private sealed class DocumentForm
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? DocumentTypeId { get; set; }
        public DateTime DocumentDate { get; set; } = DateTime.Today;
        public string? FileName { get; set; }
        public string? MimeType { get; set; }
        public string? Notes { get; set; }
    }
}
