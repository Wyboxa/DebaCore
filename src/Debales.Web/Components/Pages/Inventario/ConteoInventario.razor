@page "/inventario/conteo"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetInventoryCountsHandler GetCounts
@inject CreateInventoryCountHandler CreateHandler
@inject GetWarehousesHandler GetWarehouses
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Recuentos de inventario — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Recuentos de inventario</h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nuevo recuento</button>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <select class="form-select" style="max-width:220px" @onchange="OnWarehouseChanged">
        <option value="">Todos los almacenes</option>
        @foreach (var w in _warehouses)
        {
            <option value="@w.Id">@w.Name</option>
        }
    </select>
    <select class="form-select" style="max-width:180px" @onchange="OnStatusChanged">
        <option value="">Todos los estados</option>
        <option value="Open">Abiertos</option>
        <option value="Closed">Cerrados</option>
    </select>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Almacén</th>
                        <th class="text-center">Artículos</th>
                        <th class="text-center">Contados</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _result.Items)
                    {
                        <tr style="cursor:pointer" @onclick="() => GoToDetail(c.Id)">
                            <td><code>@c.Number</code></td>
                            <td>@c.Date.ToString("dd/MM/yyyy")</td>
                            <td>@c.WarehouseName</td>
                            <td class="text-center">@c.LineCount</td>
                            <td class="text-center">
                                @if (c.LineCount > 0)
                                {
                                    <span class="@(c.CountedLines == c.LineCount ? "text-success" : "text-muted")">
                                        @c.CountedLines / @c.LineCount
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (c.Status == "Open")
                                {
                                    <span class="badge bg-success">Abierto</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cerrado</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => GoToDetail(c.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                    @if (!_result.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay recuentos registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(_result.HasPreviousPage ? "" : "disabled")">
                    <button class="page-link" @onclick="PrevPage">Anterior</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @_result.Page de @_result.TotalPages</span>
                </li>
                <li class="page-item @(_result.HasNextPage ? "" : "disabled")">
                    <button class="page-link" @onclick="NextPage">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (_showCreate)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo recuento</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Almacén *</label>
                        <select class="form-select" @bind="_form.WarehouseIdStr">
                            <option value="">Seleccionar almacén…</option>
                            @foreach (var w in _warehouses)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha *</label>
                        <input type="date" class="form-control" @bind="_form.Date" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notas</label>
                        <textarea class="form-control" @bind="_form.Notes" rows="2" placeholder="Opcional…"></textarea>
                    </div>
                    @if (_createError is not null)
                    {
                        <div class="alert alert-danger py-2">@_createError</div>
                    }
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreate">Cancelar</button>
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="CreateCount">
                            @(_saving ? "Creando…" : "Crear recuento")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    PagedResult<InventoryCountSummaryDto>? _result;
    List<WarehouseSummaryDto> _warehouses = [];
    Guid? _warehouseFilter;
    InventoryCountStatus? _statusFilter;
    int _page = 1;
    bool _loading = true;
    bool _showCreate;
    bool _saving;
    string? _createError;
    CreateForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _warehouses = (await GetWarehouses.Handle(new GetWarehousesQuery(true))).ToList();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _result = await GetCounts.Handle(new GetInventoryCountsQuery(_warehouseFilter, _statusFilter, _page, 20));
        _loading = false;
    }

    async Task OnWarehouseChanged(ChangeEventArgs e)
    {
        _warehouseFilter = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _page = 1; await LoadAsync();
    }

    async Task OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = v == "Open" ? InventoryCountStatus.Open
            : v == "Closed" ? InventoryCountStatus.Closed
            : null;
        _page = 1; await LoadAsync();
    }

    void GoToDetail(Guid id) => Nav.NavigateTo($"/inventario/conteo/{id}");

    async Task PrevPage() { _page--; await LoadAsync(); }
    async Task NextPage() { _page++; await LoadAsync(); }

    void OpenCreate() { _form = new() { Date = DateOnly.FromDateTime(DateTime.Today) }; _createError = null; _showCreate = true; }
    void CloseCreate() => _showCreate = false;

    async Task CreateCount()
    {
        if (!Guid.TryParse(_form.WarehouseIdStr, out var wid)) { _createError = "Selecciona un almacén."; return; }
        _saving = true; _createError = null;
        try
        {
            var result = await CreateHandler.Handle(new CreateInventoryCountCommand(wid, _form.Date, _form.Notes, "web"));
            _showCreate = false;
            Toast.Show($"Recuento {result.Number} creado");
            Nav.NavigateTo($"/inventario/conteo/{result.Id}");
        }
        catch (Exception ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    sealed class CreateForm
    {
        public string? WarehouseIdStr { get; set; }
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string? Notes { get; set; }
    }
}
