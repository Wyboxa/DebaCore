@page "/facturacion"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetSalesInvoicesHandler GetSalesInvoices
@inject GetPurchaseInvoicesHandler GetPurchaseInvoices
@inject GetReceivablesHandler GetReceivables
@inject GetPayablesHandler GetPayables
@inject GetSalesCreditNotesHandler GetSalesCreditNotes
@inject GetPurchaseCreditNotesHandler GetPurchaseCreditNotes
@inject NavigationManager Nav

<PageTitle>Facturación — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Facturación</h1>
        <small class="text-muted">Facturas, vencimientos y cobros/pagos</small>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("/facturacion/ventas")'>
                <div class="card-body p-3">
                    <div class="rounded-2 p-2 bg-primary bg-opacity-10 text-primary d-inline-block mb-2">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm-1 8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H2a2 2 0 0 0-2 2zm3.5-6a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1z"/></svg>
                    </div>
                    <div class="h4 fw-bold mb-0">@_salesInvoiceCount</div>
                    <div class="small text-muted">Facturas venta</div>
                    <div class="small text-success mt-1">@_salesInvoicePosted contabilizadas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("/facturacion/compras")'>
                <div class="card-body p-3">
                    <div class="rounded-2 p-2 bg-info bg-opacity-10 text-info d-inline-block mb-2">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5z"/></svg>
                    </div>
                    <div class="h4 fw-bold mb-0">@_purchaseInvoiceCount</div>
                    <div class="small text-muted">Facturas compra</div>
                    <div class="small text-success mt-1">@_purchaseInvoicePosted contabilizadas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="rounded-2 p-2 bg-warning bg-opacity-10 text-warning d-inline-block mb-2">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718z"/></svg>
                    </div>
                    <div class="h4 fw-bold mb-0">@_pendingReceivables.ToString("N0") €</div>
                    <div class="small text-muted">Pendiente de cobro</div>
                    <div class="small text-muted mt-1">@_receivableCount vencimientos</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="rounded-2 p-2 bg-danger bg-opacity-10 text-danger d-inline-block mb-2">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718z"/></svg>
                    </div>
                    <div class="h4 fw-bold mb-0">@_pendingPayables.ToString("N0") €</div>
                    <div class="small text-muted">Pendiente de pago</div>
                    <div class="small text-muted mt-1">@_payableCount vencimientos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- Cobros pendientes -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Próximos vencimientos de cobro</span>
                    <a href="/facturacion/ventas" class="btn btn-sm btn-outline-primary" style="font-size:.8rem">Ver facturas</a>
                </div>
                @if (_topReceivables.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Sin vencimientos pendientes.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Número</th>
                                    <th>Cliente</th>
                                    <th>Vencimiento</th>
                                    <th class="text-end pe-3">Pendiente</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _topReceivables)
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace small">@r.Number</td>
                                        <td class="small">@r.CustomerName</td>
                                        <td class="small @(r.DueDate < DateOnly.FromDateTime(DateTime.Today) ? "text-danger fw-semibold" : "")">
                                            @r.DueDate.ToString("dd/MM/yyyy")
                                        </td>
                                        <td class="text-end pe-3 small fw-semibold">@r.PendingAmount.ToString("N2") €</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Pagos pendientes -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Próximos vencimientos de pago</span>
                    <a href="/facturacion/compras" class="btn btn-sm btn-outline-primary" style="font-size:.8rem">Ver facturas</a>
                </div>
                @if (_topPayables.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Sin vencimientos pendientes.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Número</th>
                                    <th>Proveedor</th>
                                    <th>Vencimiento</th>
                                    <th class="text-end pe-3">Pendiente</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _topPayables)
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace small">@p.Number</td>
                                        <td class="small">@p.SupplierName</td>
                                        <td class="small @(p.DueDate < DateOnly.FromDateTime(DateTime.Today) ? "text-danger fw-semibold" : "")">
                                            @p.DueDate.ToString("dd/MM/yyyy")
                                        </td>
                                        <td class="text-end pe-3 small fw-semibold">@p.PendingAmount.ToString("N2") €</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="row g-2">
        @foreach (var link in _quickLinks)
        {
            <div class="col-6 col-md-3">
                <a href="@link.Url" class="card border-0 shadow-sm text-decoration-none text-dark p-3 d-flex flex-row align-items-center gap-2 h-100">
                    <span class="text-primary">@((MarkupString)link.Icon)</span>
                    <span class="small fw-semibold">@link.Label</span>
                </a>
            </div>
        }
    </div>
}

@code {
    bool _loading = true;

    int _salesInvoiceCount, _salesInvoicePosted;
    int _purchaseInvoiceCount, _purchaseInvoicePosted;
    decimal _pendingReceivables;
    int _receivableCount;
    decimal _pendingPayables;
    int _payableCount;

    List<ReceivableSummaryDto> _topReceivables = [];
    List<PayableSummaryDto> _topPayables = [];

    record QuickLink(string Label, string Url, string Icon);
    List<QuickLink> _quickLinks =
    [
        new("Facturas venta", "/facturacion/ventas", "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z'/></svg>"),
        new("Rectificativas venta", "/facturacion/rectificativas-venta", "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M1.5 1a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5z'/></svg>"),
        new("Facturas compra", "/facturacion/compras", "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5z'/></svg>"),
        new("Rectificativas compra", "/facturacion/rectificativas-compra", "<svg width='18' height='18' fill='currentColor' viewBox='0 0 16 16'><path d='M1.5 1a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5z'/></svg>"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var t1 = GetSalesInvoices.Handle(new GetSalesInvoicesQuery(null, null, null, 1, 500));
        var t2 = GetPurchaseInvoices.Handle(new GetPurchaseInvoicesQuery(null, null, null, 1, 500));
        var t3 = GetReceivables.Handle(new GetReceivablesQuery(null, null, null, 1, 200));
        var t4 = GetPayables.Handle(new GetPayablesQuery(null, null, null, 1, 200));

        await Task.WhenAll(t1, t2, t3, t4);

        var si = t1.Result.Items;
        _salesInvoiceCount = si.Count;
        _salesInvoicePosted = si.Count(i => i.Status == SalesInvoiceStatus.Posted);

        var pi = t2.Result.Items;
        _purchaseInvoiceCount = pi.Count;
        _purchaseInvoicePosted = pi.Count(i => i.Status == PurchaseInvoiceStatus.Posted);

        var rec = t3.Result.Items
            .Where(r => r.Status == ReceivableStatus.Pending || r.Status == ReceivableStatus.Partial)
            .ToList();
        _receivableCount = rec.Count;
        _pendingReceivables = rec.Sum(r => r.PendingAmount);
        _topReceivables = rec.OrderBy(r => r.DueDate).Take(8).ToList();

        var pay = t4.Result.Items
            .Where(p => p.Status == PayableStatus.Pending || p.Status == PayableStatus.Partial)
            .ToList();
        _payableCount = pay.Count;
        _pendingPayables = pay.Sum(p => p.PendingAmount);
        _topPayables = pay.OrderBy(p => p.DueDate).Take(8).ToList();

        _loading = false;
    }
}
