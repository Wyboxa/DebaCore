@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetDashboardStatsHandler StatsHandler
@inject GetDashboardBriefingHandler BriefingHandler
@using Debales.Application.CRM.Dashboard
@using Debales.Application.AI.Briefing

<PageTitle>Dashboard — Debales CRM</PageTitle>

@if (_loading)
{
    <div class="d-flex align-items-center justify-content-center" style="height:60vh">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3"></div>
            <p class="text-muted">Cargando dashboard…</p>
        </div>
    </div>
}
else if (_stats is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h4 fw-bold mb-0">Panel de control</h1>
            <small class="text-muted">@DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))</small>
        </div>
        <a href="/crm/customers" class="btn btn-primary btn-sm">+ Nuevo cliente</a>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 kpi-card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrap icon-emerald">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
                            </svg>
                        </div>
                        <div>
                            <div class="h3 fw-bold mb-0">@_stats.ActiveCustomers</div>
                            <div class="small text-muted">Clientes activos</div>
                            <div class="small text-muted">de @_stats.TotalCustomers totales</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 kpi-card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrap icon-emerald">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M0 0h1v15h15v1H0zm10 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-1 0V4.9l-3.613 4.417a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61L13.445 4H10.5a.5.5 0 0 1-.5-.5"/>
                            </svg>
                        </div>
                        <div>
                            <div class="h3 fw-bold mb-0">@_stats.PipelineValue.ToString("N0") €</div>
                            <div class="small text-muted">Valor pipeline</div>
                            <div class="small text-muted">@_stats.OpenOpportunities oport. abiertas</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 kpi-card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrap icon-amber">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M10.854 7.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 9.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="h3 fw-bold mb-0">@_stats.PendingActivities</div>
                            <div class="small text-muted">Actividades pendientes</div>
                            <div class="small @(_stats.OverdueActivities > 0 ? "text-danger fw-semibold" : "text-muted")">
                                @(_stats.OverdueActivities > 0 ? $"{_stats.OverdueActivities} vencidas" : "Al día")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 kpi-card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrap icon-violet">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z"/>
                            </svg>
                        </div>
                        <div>
                            @{
                                var wonCount = _stats.Pipeline.FirstOrDefault(p => p.Stage == "Won")?.Count ?? 0;
                                var lostCount = _stats.Pipeline.FirstOrDefault(p => p.Stage == "Lost")?.Count ?? 0;
                                var total = _stats.Pipeline.Sum(p => p.Count);
                                var winRate = total > 0 ? (int)Math.Round((double)wonCount / total * 100) : 0;
                            }
                            <div class="h3 fw-bold mb-0">@winRate%</div>
                            <div class="small text-muted">Tasa de conversión</div>
                            <div class="small text-muted">@wonCount ganadas · @lostCount perdidas</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Briefing IA + Pipeline -->
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge-ia">IA</span>
                        <span class="fw-semibold">Briefing del día</span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshBriefing" disabled="@_briefingLoading">
                        @(_briefingLoading ? "Generando…" : "↺ Actualizar")
                    </button>
                </div>
                <div class="card-body">
                    @if (_briefingLoading)
                    {
                        <div class="d-flex align-items-center gap-2 text-muted">
                            <div class="spinner-border spinner-border-sm"></div>
                            <span>Claude está analizando el pipeline…</span>
                        </div>
                    }
                    else if (_briefing is not null)
                    {
                        <p class="mb-0" style="white-space:pre-wrap;line-height:1.7">@_briefing</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Pulsa "Actualizar" para obtener el briefing del día.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Pipeline de oportunidades</span>
                </div>
                <div class="card-body">
                    @if (!_stats.Pipeline.Any())
                    {
                        <p class="text-muted mb-0">Sin oportunidades registradas.</p>
                    }
                    else
                    {
                        @foreach (var stage in _stats.Pipeline.OrderBy(p => StageOrder(p.Stage)))
                        {
                            var pct = _stats.Pipeline.Sum(x => x.Count) > 0
                                ? (int)Math.Round((double)stage.Count / _stats.Pipeline.Sum(x => x.Count) * 100)
                                : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-semibold">@StageLabel(stage.Stage)</span>
                                    <span class="small text-muted">@stage.Count · @stage.Value.ToString("N0") €</span>
                                </div>
                                <div class="progress" style="height:8px">
                                    <div class="progress-bar @StageBgClass(stage.Stage)" style="width:@pct%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Últimos clientes + Próximas actividades -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Últimos clientes</span>
                    <a href="/crm/customers" class="btn btn-sm btn-outline-primary" style="font-size:0.8rem">Ver todos</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (!_stats.RecentCustomers.Any())
                    {
                        <div class="list-group-item text-muted text-center py-4">Sin clientes registrados.</div>
                    }
                    @foreach (var c in _stats.RecentCustomers)
                    {
                        <a href="/crm/customers/@c.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <div>
                                <div class="fw-semibold">@c.Name</div>
                                <small class="text-muted">@(c.Sector ?? "Sin sector")</small>
                            </div>
                            <small class="text-muted">@c.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Actividades próximas</span>
                </div>
                <div class="list-group list-group-flush">
                    @if (!_stats.UpcomingActivities.Any())
                    {
                        <div class="list-group-item text-muted text-center py-4">Sin actividades programadas.</div>
                    }
                    @foreach (var a in _stats.UpcomingActivities)
                    {
                        <a href="/crm/customers/@a.CustomerId" class="list-group-item list-group-item-action py-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (a.IsOverdue)
                                        {
                                            <span class="badge bg-danger">Vencida</span>
                                        }
                                        <span class="badge bg-secondary">@a.Type</span>
                                        <span class="fw-semibold small">@a.Subject</span>
                                    </div>
                                    <small class="text-muted">@a.CustomerName</small>
                                </div>
                                <small class="@(a.IsOverdue ? "text-danger" : "text-muted") text-nowrap ms-2">
                                    @a.ScheduledAt.ToString("dd/MM HH:mm")
                                </small>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardStatsDto? _stats;
    private string? _briefing;
    private bool _loading = true;
    private bool _briefingLoading;

    protected override async Task OnInitializedAsync()
    {
        _stats = await StatsHandler.Handle(new GetDashboardStatsQuery());
        _loading = false;
        _ = RefreshBriefing();
    }

    private async Task RefreshBriefing()
    {
        if (_stats is null) return;
        _briefingLoading = true;
        _briefing = null;
        StateHasChanged();
        try
        {
            _briefing = await BriefingHandler.Handle(new GetDashboardBriefingQuery(_stats));
        }
        catch (Exception ex) { _briefing = $"No se pudo generar el briefing: {ex.Message}"; }
        finally { _briefingLoading = false; StateHasChanged(); }
    }

    private static int StageOrder(string stage) => stage switch
    {
        "New" => 1, "InProgress" => 2, "Won" => 3, "Lost" => 4, _ => 5
    };

    private static string StageLabel(string stage) => stage switch
    {
        "New" => "Nuevo", "InProgress" => "En curso", "Won" => "Ganado", "Lost" => "Perdido", _ => stage
    };

    private static string StageBgClass(string stage) => stage switch
    {
        "Won" => "bg-success", "Lost" => "bg-danger", "InProgress" => "bg-warning", _ => "bg-primary"
    };
}
