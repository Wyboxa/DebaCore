@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end gap-3">
            <AuthorizeView>
                <Authorized>
                    <span class="small text-muted">
                        <span class="bi bi-person-circle me-1"></span>@context.User.Identity?.Name
                    </span>
                    <form method="post" action="/auth/logout" style="margin:0;">
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">Salir</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <ModuleRouteGuard>
                @Body
            </ModuleRouteGuard>
        </article>
    </main>
</div>

<ToastContainer />
<TutorialOverlay />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
