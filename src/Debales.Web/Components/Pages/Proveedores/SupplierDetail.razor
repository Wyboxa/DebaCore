@page "/proveedores/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetSupplierByIdHandler GetById
@inject UpdateSupplierHandler UpdateHandler
@inject GetSupplierItemCodesHandler GetItemCodes
@inject UpsertSupplierItemCodeHandler UpsertItemCode
@inject DeleteSupplierItemCodeHandler DeleteItemCode
@inject GetItemsHandler GetItems
@inject GetPaymentTermsHandler GetPaymentTermsList
@inject GetPaymentMethodsHandler GetPaymentMethodsList
@inject GetSupplierStatementHandler StatementHandler
@inject GetPurchaseOrdersHandler GetOrders
@inject GetContactsBySupplierHandler GetContacts
@inject AddSupplierContactHandler AddContact
@inject UpdateSupplierContactHandler UpdateContact
@inject DeactivateSupplierContactHandler DeactivateContact
@inject ToastService Toast
@inject NavigationManager Nav
@inject GetDocumentsHandler GetDocuments

<PageTitle>@(_supplier?.Name ?? "Proveedor") — Debales</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_supplier is null)
{
    <div class="alert alert-warning">Proveedor no encontrado. <a href="/proveedores">Volver</a></div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/proveedores">Proveedores</a></li>
            <li class="breadcrumb-item active">@_supplier.Name</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1">@_supplier.Name</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (_supplier.TaxId is not null)
                {
                    <span class="text-muted small">@_supplier.TaxId</span>
                }
                @if (_supplier.IsActive)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </div>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="OpenEdit">Editar</button>
    </div>

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in new[] { "info", "notas", "contactos", "codigos", "pedidos", "cuenta", "documentos" })
        {
            <li class="nav-item">
                <button class="nav-link @(_tab == tab ? "active" : "")" @onclick="() => OnTabChange(tab)">
                    @TabLabel(tab)
                </button>
            </li>
        }
    </ul>

    @if (_tab == "info")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <dl class="mb-0">
                            <dt class="small text-muted fw-semibold mb-1">Nombre</dt>
                            <dd class="mb-3">@_supplier.Name</dd>

                            <dt class="small text-muted fw-semibold mb-1">CIF / NIF</dt>
                            <dd class="mb-3">@(_supplier.TaxId ?? "—")</dd>

                            <dt class="small text-muted fw-semibold mb-1">Persona de contacto</dt>
                            <dd class="mb-3">@(_supplier.ContactName ?? "—")</dd>

                            <dt class="small text-muted fw-semibold mb-1">Teléfono</dt>
                            <dd class="mb-3">@(_supplier.Phone ?? "—")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="mb-0">
                            <dt class="small text-muted fw-semibold mb-1">Email</dt>
                            <dd class="mb-3">
                                @if (_supplier.Email is not null)
                                {
                                    <a href="mailto:@_supplier.Email">@_supplier.Email</a>
                                }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Web</dt>
                            <dd class="mb-3">
                                @if (_supplier.Website is not null)
                                {
                                    <a href="@_supplier.Website" target="_blank" rel="noopener">@_supplier.Website</a>
                                }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Dirección</dt>
                            <dd class="mb-3">
                                @if (_supplier.Address is not null)
                                {
                                    <span>@_supplier.Address.Street, @_supplier.Address.City @_supplier.Address.PostalCode — @_supplier.Address.Country</span>
                                }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Cuenta contable</dt>
                            <dd class="mb-3">@(_supplier.AccountCode ?? "—")</dd>

                            <dt class="small text-muted fw-semibold mb-1">Condición de pago</dt>
                            <dd class="mb-3">
                                @if (_supplier.PaymentTermId.HasValue)
                                { <span>@(_supplier.PaymentTermName ?? "—")</span> }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Forma de pago</dt>
                            <dd class="mb-3">
                                @if (_supplier.PaymentMethodId.HasValue)
                                { <span>@(_supplier.PaymentMethodName ?? "—")</span> }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Alta</dt>
                            <dd class="mb-0">@_supplier.CreatedAt.ToString("dd/MM/yyyy")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_tab == "notas")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(_supplier.Notes))
                {
                    <p style="white-space:pre-wrap">@_supplier.Notes</p>
                }
                else
                {
                    <p class="text-muted mb-0">Sin notas. Edita el proveedor para añadir observaciones.</p>
                }
            </div>
        </div>
    }

    @if (_tab == "contactos")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Contactos del proveedor</span>
                <button class="btn btn-sm btn-primary" @onclick="OpenAddContact">+ Añadir contacto</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Nombre</th>
                            <th>Cargo</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_contactsLoading)
                        {
                            <tr><td colspan="6" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                        }
                        else
                        {
                            @foreach (var c in _contacts)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@c.FullName</td>
                                    <td class="text-muted small">@(c.JobTitle ?? "—")</td>
                                    <td class="small">
                                        @if (c.Email is not null)
                                        { <a href="mailto:@c.Email">@c.Email</a> }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="small">@(c.Phone ?? "—")</td>
                                    <td>
                                        @if (c.IsActive)
                                        { <span class="badge bg-success">Activo</span> }
                                        else
                                        { <span class="badge bg-secondary">Inactivo</span> }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                @onclick="() => OpenEditContact(c)">Editar</button>
                                        @if (c.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ConfirmDeactivateContact(c)">Dar de baja</button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!_contacts.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">Sin contactos registrados. Añade el primero con el botón superior.</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_tab == "codigos")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Códigos de artículo del proveedor</span>
                <button class="btn btn-sm btn-primary" @onclick="OpenAddCode">+ Añadir código</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Artículo</th>
                            <th>Código proveedor</th>
                            <th>Descripción</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_codesLoading)
                        {
                            <tr><td colspan="4" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                        }
                        else
                        {
                            @foreach (var c in _itemCodes)
                            {
                                <tr>
                                    <td><code>@c.ItemCode</code> @c.ItemName</td>
                                    <td><strong>@c.SupplierCode</strong></td>
                                    <td class="text-muted">@(c.Description ?? "—")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                @onclick="() => OpenEditCode(c)">Editar</button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDeleteCode(c)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                            @if (!_itemCodes.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Sin códigos configurados.</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_tab == "pedidos")
{
    @if (_pedidosLoading)
    {
        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
    }
    else if (!_pedidos.Any())
    {
        <div class="alert alert-info">Sin pedidos de compra registrados para este proveedor.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Pedidos de compra</span>
                <a href="/compras/pedidos" class="btn btn-sm btn-outline-secondary">Ver todos</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Número</th>
                            <th>Fecha</th>
                            <th>F. recepción</th>
                            <th>Estado</th>
                            <th class="text-end pe-3">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in _pedidos.OrderByDescending(p => p.Date))
                        {
                            <tr style="cursor:pointer" @onclick="() => GoToPurchaseOrder(o.Id)">
                                <td class="ps-3 font-monospace small">@o.Number</td>
                                <td class="small">@o.Date.ToString("dd/MM/yyyy")</td>
                                <td class="small text-muted">@(o.ExpectedReceiptDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td><span class="badge @PurchaseOrderBadge(o.Status)">@o.StatusLabel</span></td>
                                <td class="text-end pe-3 fw-semibold">@o.Total.ToString("N2") €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_tab == "cuenta")
{
    @if (_stmtLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_statement is not null)
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-1">Total cargos (rect. + pagos)</div>
                        <div class="fw-bold fs-5 text-success">@_statement.TotalDebit.ToString("N2") €</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-1">Total abonos (facturas)</div>
                        <div class="fw-bold fs-5">@_statement.TotalCredit.ToString("N2") €</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 @(_statement.Balance > 0 ? "border-start border-warning border-3" : "")">
                    <div class="card-body">
                        <div class="text-muted small mb-1">Saldo pendiente (deuda)</div>
                        <div class="fw-bold fs-5 @(_statement.Balance > 0 ? "text-warning" : "text-success")">@_statement.Balance.ToString("N2") €</div>
                    </div>
                </div>
            </div>
        </div>
        @if (_statement.Lines.Count == 0)
        {
            <div class="alert alert-info">Sin movimientos registrados.</div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Fecha</th>
                                <th>Tipo</th>
                                <th>Referencia</th>
                                <th class="text-end">Cargo</th>
                                <th class="text-end">Abono</th>
                                <th class="text-end pe-3">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _statement.Lines)
                            {
                                <tr>
                                    <td class="ps-3 small">@l.Date.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge @SupplierStmtBadge(l.Type)">@l.Type</span></td>
                                    <td class="font-monospace small">@l.Reference</td>
                                    <td class="text-end small text-success">@(l.Debit > 0 ? l.Debit.ToString("N2") + " €" : "—")</td>
                                    <td class="text-end small">@(l.Credit > 0 ? l.Credit.ToString("N2") + " €" : "—")</td>
                                    <td class="text-end pe-3 fw-semibold @(l.Balance > 0 ? "text-warning" : "text-success")">@l.Balance.ToString("N2") €</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

@* ── Add/edit contact modal ── *@
@if (_showContactModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingContact is not null ? "Editar contacto" : "Nuevo contacto")</h5>
                    <button type="button" class="btn-close" @onclick="() => _showContactModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="_contactForm.FirstName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Apellidos *</label>
                            <InputText class="form-control" @bind-Value="_contactForm.LastName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Cargo</label>
                            <InputText class="form-control" @bind-Value="_contactForm.JobTitle" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="_contactForm.Email" type="email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <InputText class="form-control" @bind-Value="_contactForm.Phone" />
                        </div>
                    </div>
                    @if (_contactError is not null) { <div class="alert alert-danger mt-2">@_contactError</div> }
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => _showContactModal = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveContact" disabled="@_saving">
                            @(_saving ? "Guardando…" : "Guardar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate contact confirm ── *@
@if (_deactivatingContact is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="() => _deactivatingContact = null"></button>
                </div>
                <div class="modal-body">
                    ¿Dar de baja a <strong>@_deactivatingContact.FullName</strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deactivatingContact = null">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDeactivateContact" disabled="@_saving">Dar de baja</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Add/edit item code modal ── *@
@if (_showCodeModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingCode is not null ? "Editar código" : "Añadir código")</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCodeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">Artículo *</label>
                            @if (_editingCode is not null)
                            {
                                <input class="form-control" readonly value="@(_editingCode.ItemCode + " — " + _editingCode.ItemName)" />
                            }
                            else
                            {
                                <select class="form-select" @bind="_codeForm.ItemIdStr">
                                    <option value="">Seleccionar…</option>
                                    @foreach (var item in _allItems)
                                    {
                                        <option value="@item.Id">@item.Code — @item.Name</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Código del proveedor *</label>
                            <InputText class="form-control text-uppercase" @bind-Value="_codeForm.SupplierCode" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control" @bind-Value="_codeForm.Description" />
                        </div>
                    </div>
                    @if (_codeError is not null) { <div class="alert alert-danger mt-2">@_codeError</div> }
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => _showCodeModal = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveCode" disabled="@_saving">
                            @(_saving ? "Guardando…" : "Guardar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ── Delete confirm ── *@
@if (_deletingCode is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="() => _deletingCode = null"></button>
                </div>
                <div class="modal-body">
                    ¿Eliminar el código <strong>@_deletingCode.SupplierCode</strong> para @_deletingCode.ItemName?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deletingCode = null">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDeleteCode" disabled="@_saving">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showEdit && _supplier is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar proveedor</h5>
                    <button type="button" class="btn-close" @onclick="() => _showEdit = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_editForm" OnValidSubmit="SaveEdit">
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="_editForm.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">CIF / NIF</label>
                                <InputText class="form-control" @bind-Value="_editForm.TaxId" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Persona de contacto</label>
                                <InputText class="form-control" @bind-Value="_editForm.ContactName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="_editForm.Phone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="_editForm.Email" type="email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Web</label>
                                <InputText class="form-control" @bind-Value="_editForm.Website" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Cuenta contable</label>
                                <InputText class="form-control" @bind-Value="_editForm.AccountCode" placeholder="p.ej. 4000001" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Condición de pago</label>
                                <select class="form-select" @bind="_editForm.PaymentTermIdStr">
                                    <option value="">Sin condición</option>
                                    @foreach (var pt in _availablePaymentTerms)
                                    {
                                        <option value="@pt.Id">@pt.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Forma de pago</label>
                                <select class="form-select" @bind="_editForm.PaymentMethodIdStr">
                                    <option value="">Sin forma de pago</option>
                                    @foreach (var pm in _availablePaymentMethods)
                                    {
                                        <option value="@pm.Id">@pm.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <hr class="my-2" />
                        <div class="small text-muted fw-semibold mb-2">Dirección</div>
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <label class="form-label">Calle</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressStreet" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ciudad</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressCity" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">C.P.</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressPostalCode" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">País</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressCountry" />
                            </div>
                        </div>
                        <hr class="my-2" />
                        <div class="mb-2">
                            <label class="form-label">Notas internas</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_editForm.Notes" />
                        </div>
                        @if (_editError is not null) { <div class="alert alert-danger mt-2">@_editError</div> }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="() => _showEdit = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (_tab == "documentos")
{
    @if (_docsLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-semibold text-muted">@_docs.Count documento(s)</span>
            <a class="btn btn-sm btn-primary" href="/documentos">+ Nuevo documento</a>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Título</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _docs)
                        {
                            <tr>
                                <td><strong>@d.Title</strong></td>
                                <td class="text-muted small">@d.DocumentTypeName</td>
                                <td class="text-muted small">@d.DocumentDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" href="/documentos/@d.Id">Ver</a>
                                </td>
                            </tr>
                        }
                        @if (!_docs.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No hay documentos vinculados a este proveedor.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SupplierDetailDto? _supplier;
    private bool _loading = true;
    private string _tab = "info";
    private bool _saving;
    private bool _showEdit;
    private string? _editError;
    private EditFormModel _editForm = new();

    private List<PaymentTermSummaryDto> _availablePaymentTerms = [];
    private List<PaymentMethodSummaryDto> _availablePaymentMethods = [];

    // ── Contacts ────────────────────────────────────────────────────────────
    private List<SupplierContactDto> _contacts = [];
    private bool _contactsLoading;
    private bool _showContactModal;
    private SupplierContactDto? _editingContact;
    private SupplierContactDto? _deactivatingContact;
    private string? _contactError;
    private ContactForm _contactForm = new();

    // ── Item codes ──────────────────────────────────────────────────────────
    private List<SupplierItemCodeDto> _itemCodes = [];
    private List<ItemSummaryDto> _allItems = [];
    private bool _codesLoading;
    private bool _showCodeModal;
    private SupplierItemCodeDto? _editingCode;
    private SupplierItemCodeDto? _deletingCode;
    private string? _codeError;
    private CodeForm _codeForm = new();

    protected override async Task OnInitializedAsync()
    {
        _supplier = await GetById.Handle(new GetSupplierByIdQuery(Id));
        _loading = false;
    }

    private static string TabLabel(string tab) => tab switch
    {
        "info"      => "Información",
        "notas"     => "Notas",
        "contactos" => "Contactos",
        "codigos"   => "Códigos",
        "pedidos"   => "Pedidos",
        "cuenta"        => "Estado de cuenta",
        "documentos"    => "Documentos",
        _               => tab
    };

    Debales.Application.Common.StatementDto? _statement;
    bool _stmtLoading;
    List<PurchaseOrderSummaryDto> _pedidos = [];
    bool _pedidosLoading;
    List<DocumentDto> _docs = [];
    bool _docsLoading;

    private async Task OnTabChange(string tab)
    {
        _tab = tab;
        if (tab == "contactos" && !_contacts.Any() && !_contactsLoading)
            _ = LoadContactsAsync();
        if (tab == "codigos" && !_itemCodes.Any())
            await LoadCodesAsync();
        if (tab == "cuenta" && _statement is null && !_stmtLoading)
            _ = LoadStatementAsync();
        if (tab == "pedidos" && !_pedidos.Any() && !_pedidosLoading)
            _ = LoadPedidosAsync();
        if (tab == "documentos" && !_docs.Any() && !_docsLoading)
            _ = LoadDocsAsync();
    }

    private async Task LoadContactsAsync()
    {
        _contactsLoading = true;
        _contacts = (await GetContacts.Handle(new GetContactsBySupplierQuery(Id))).ToList();
        _contactsLoading = false;
        StateHasChanged();
    }

    private void OpenAddContact()
    {
        _editingContact = null;
        _contactForm = new();
        _contactError = null;
        _showContactModal = true;
    }

    private void OpenEditContact(SupplierContactDto c)
    {
        _editingContact = c;
        _contactForm = new ContactForm
        {
            FirstName = c.FirstName, LastName = c.LastName,
            JobTitle = c.JobTitle, Email = c.Email, Phone = c.Phone
        };
        _contactError = null;
        _showContactModal = true;
    }

    private async Task SaveContact()
    {
        if (string.IsNullOrWhiteSpace(_contactForm.FirstName)) { _contactError = "El nombre es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_contactForm.LastName)) { _contactError = "Los apellidos son obligatorios."; return; }

        _saving = true;
        _contactError = null;
        try
        {
            if (_editingContact is null)
            {
                var result = await AddContact.Handle(new AddSupplierContactCommand(
                    Id, _contactForm.FirstName!, _contactForm.LastName!,
                    _contactForm.JobTitle, _contactForm.Email, _contactForm.Phone, "web"));
                _contacts.Insert(0, result);
            }
            else
            {
                var result = await UpdateContact.Handle(new UpdateSupplierContactCommand(
                    _editingContact.Id, _contactForm.FirstName!, _contactForm.LastName!,
                    _contactForm.JobTitle, _contactForm.Email, _contactForm.Phone, "web"));
                var idx = _contacts.FindIndex(c => c.Id == result.Id);
                if (idx >= 0) _contacts[idx] = result;
            }
            _showContactModal = false;
            Toast.Show(_editingContact is null ? "Contacto añadido" : "Contacto actualizado");
        }
        catch (Exception ex) { _contactError = ex.Message; }
        finally { _saving = false; }
    }

    private void ConfirmDeactivateContact(SupplierContactDto c) => _deactivatingContact = c;

    private async Task ExecuteDeactivateContact()
    {
        if (_deactivatingContact is null) return;
        _saving = true;
        try
        {
            await DeactivateContact.Handle(new DeactivateSupplierContactCommand(_deactivatingContact.Id, "web"));
            _contacts = _contacts.Select(c => c.Id == _deactivatingContact.Id
                ? c with { IsActive = false }
                : c).ToList();
            _deactivatingContact = null;
            Toast.Show("Contacto dado de baja");
        }
        catch (Exception ex) { Toast.Show(ex.Message); }
        finally { _saving = false; }
    }

    private sealed class ContactForm
    {
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? JobTitle { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
    }

    private async Task LoadPedidosAsync()
    {
        _pedidosLoading = true;
        var result = await GetOrders.Handle(new GetPurchaseOrdersQuery(null, Id, null, 1, 200));
        _pedidos = result.Items.ToList();
        _pedidosLoading = false;
        StateHasChanged();
    }

    private async Task LoadDocsAsync()
    {
        _docsLoading = true;
        var result = await GetDocuments.Handle(new GetDocumentsQuery(null, null, null, Id, 1, 200));
        _docs = result.Items.ToList();
        _docsLoading = false;
        StateHasChanged();
    }

    private void GoToPurchaseOrder(Guid orderId) => Nav.NavigateTo($"/compras/pedidos/{orderId}");

    private static string PurchaseOrderBadge(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft              => "bg-secondary",
        PurchaseOrderStatus.Confirmed          => "bg-primary",
        PurchaseOrderStatus.PartiallyReceived  => "bg-warning text-dark",
        PurchaseOrderStatus.Received           => "bg-success",
        PurchaseOrderStatus.Cancelled          => "bg-danger",
        _                                      => "bg-secondary"
    };

    private async Task LoadStatementAsync()
    {
        _stmtLoading = true;
        _statement = await StatementHandler.Handle(new GetSupplierStatementQuery(Id));
        _stmtLoading = false;
        StateHasChanged();
    }

    private static string SupplierStmtBadge(string type) => type switch
    {
        "Factura" => "bg-warning text-dark",
        "Rectificativa" => "bg-secondary",
        "Pago" => "bg-success",
        _ => "bg-light text-dark border"
    };

    private async Task LoadCodesAsync()
    {
        _codesLoading = true;
        _itemCodes = await GetItemCodes.Handle(new GetSupplierItemCodesQuery(Id));
        _codesLoading = false;
    }

    private async Task OpenAddCode()
    {
        if (!_allItems.Any())
        {
            var paged = await GetItems.Handle(new GetItemsQuery(null, null, null, 1, 1000));
            _allItems = paged.Items.ToList();
        }
        _editingCode = null;
        _codeForm = new();
        _codeError = null;
        _showCodeModal = true;
    }

    private void OpenEditCode(SupplierItemCodeDto c)
    {
        _editingCode = c;
        _codeForm = new CodeForm { SupplierCode = c.SupplierCode, Description = c.Description };
        _codeError = null;
        _showCodeModal = true;
    }

    private async Task SaveCode()
    {
        var itemId = _editingCode?.ItemId ?? (Guid.TryParse(_codeForm.ItemIdStr, out var g) ? g : Guid.Empty);
        if (itemId == Guid.Empty) { _codeError = "Selecciona un artículo."; return; }
        if (string.IsNullOrWhiteSpace(_codeForm.SupplierCode)) { _codeError = "El código del proveedor es obligatorio."; return; }

        _saving = true;
        _codeError = null;
        try
        {
            await UpsertItemCode.Handle(new UpsertSupplierItemCodeCommand(
                Id, itemId, _codeForm.SupplierCode!, _codeForm.Description, "web"));
            _showCodeModal = false;
            await LoadCodesAsync();
            Toast.Show("Código guardado");
        }
        catch (Exception ex) { _codeError = ex.Message; }
        finally { _saving = false; }
    }

    private void ConfirmDeleteCode(SupplierItemCodeDto c) => _deletingCode = c;

    private async Task ExecuteDeleteCode()
    {
        if (_deletingCode is null) return;
        _saving = true;
        try
        {
            await DeleteItemCode.Handle(new DeleteSupplierItemCodeCommand(Id, _deletingCode.ItemId));
            _deletingCode = null;
            await LoadCodesAsync();
            Toast.Show("Código eliminado");
        }
        catch (Exception ex) { Toast.Show(ex.Message); }
        finally { _saving = false; }
    }

    private sealed class CodeForm
    {
        public string? ItemIdStr { get; set; }
        public string? SupplierCode { get; set; }
        public string? Description { get; set; }
    }

    private async Task OpenEdit()
    {
        _editError = null;
        if (!_availablePaymentTerms.Any())
        {
            var pts = await GetPaymentTermsList.Handle(new GetPaymentTermsQuery(Page: 1, PageSize: 200));
            _availablePaymentTerms = pts.Items.ToList();
        }
        if (!_availablePaymentMethods.Any())
        {
            var pms = await GetPaymentMethodsList.Handle(new GetPaymentMethodsQuery(IsActive: true, Page: 1, PageSize: 200));
            _availablePaymentMethods = pms.Items.ToList();
        }
        _editForm = new()
        {
            Name          = _supplier!.Name,
            TaxId         = _supplier.TaxId,
            Phone         = _supplier.Phone,
            Email         = _supplier.Email,
            Website       = _supplier.Website,
            ContactName   = _supplier.ContactName,
            Notes         = _supplier.Notes,
            AddressStreet     = _supplier.Address?.Street,
            AddressCity       = _supplier.Address?.City,
            AddressPostalCode = _supplier.Address?.PostalCode,
            AddressCountry    = _supplier.Address?.Country,
            AccountCode        = _supplier.AccountCode,
            PaymentTermIdStr   = _supplier.PaymentTermId?.ToString() ?? "",
            PaymentMethodIdStr = _supplier.PaymentMethodId?.ToString() ?? ""
        };
        _showEdit = true;
    }

    private async Task SaveEdit()
    {
        _saving = true;
        _editError = null;
        try
        {
            var paymentTermId = Guid.TryParse(_editForm.PaymentTermIdStr, out var ptg) ? ptg : (Guid?)null;
            var paymentMethodId = Guid.TryParse(_editForm.PaymentMethodIdStr, out var pmg) ? pmg : (Guid?)null;
            _supplier = await UpdateHandler.Handle(new UpdateSupplierCommand(
                Id, _editForm.Name!, _editForm.TaxId, _editForm.Phone, _editForm.Email,
                _editForm.Website, _editForm.ContactName, _editForm.Notes,
                _editForm.AddressStreet, _editForm.AddressCity,
                _editForm.AddressPostalCode, _editForm.AddressCountry, "web",
                AccountCode: _editForm.AccountCode,
                PaymentTermId: paymentTermId,
                PaymentMethodId: paymentMethodId));
            _showEdit = false;
            Toast.Show("Proveedor actualizado correctamente");
        }
        catch (ArgumentException ex) { _editError = ex.Message; }
        catch (KeyNotFoundException) { _editError = "Proveedor no encontrado."; }
        finally { _saving = false; }
    }

    private sealed class EditFormModel
    {
        public string? Name { get; set; }
        public string? TaxId { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Website { get; set; }
        public string? ContactName { get; set; }
        public string? Notes { get; set; }
        public string? AddressStreet { get; set; }
        public string? AddressCity { get; set; }
        public string? AddressPostalCode { get; set; }
        public string? AddressCountry { get; set; }
        public string? AccountCode { get; set; }
        public string? PaymentTermIdStr { get; set; }
        public string? PaymentMethodIdStr { get; set; }
    }
}
