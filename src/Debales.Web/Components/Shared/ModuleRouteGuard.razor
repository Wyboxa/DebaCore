@implements IDisposable
@inject NavigationManager Nav
@inject ILicenseService LicenseService

@if (_checking || _allowed)
{
    @ChildContent
}
else
{
    <div class="d-flex flex-column align-items-center justify-content-center text-center"
         style="min-height:60vh;color:#6B9CA9;">
        <span class="bi bi-lock-fill" style="font-size:3rem;"></span>
        <h4 class="mt-3 fw-semibold">Módulo no disponible</h4>
        <p class="text-muted">Este módulo no está incluido en su licencia actual.</p>
        <a href="/licencia" class="btn btn-outline-secondary btn-sm mt-2">Ver licencia</a>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    bool _checking = true;
    bool _allowed = true;

    private static readonly (string Prefix, string Module)[] _routes =
    [
        ("/ventas",                            "Sales"),
        ("/facturacion/ventas",                "Sales"),
        ("/facturacion/rectificativas-venta",  "Sales"),
        ("/compras",                           "Purchasing"),
        ("/facturacion/compras",               "Purchasing"),
        ("/facturacion/rectificativas-compra", "Purchasing"),
        ("/inventario",                        "Inventory"),
        ("/contabilidad",                      "Accounting"),
        ("/ia",                                "AI"),
        ("/analitica",                         "AI"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await CheckCurrentRouteAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(CheckCurrentRouteAsync);

    private async Task CheckCurrentRouteAsync()
    {
        _checking = true;

        var path = new Uri(Nav.Uri).AbsolutePath;
        var module = ResolveModule(path);

        if (module is null)
        {
            _allowed = true;
            _checking = false;
            StateHasChanged();
            return;
        }

        if (!await LicenseService.IsValidAsync())
        {
            _allowed = true;
            _checking = false;
            StateHasChanged();
            return;
        }

        _allowed = await LicenseService.IsModuleActiveAsync(module);
        _checking = false;
        StateHasChanged();
    }

    private static string? ResolveModule(string path)
    {
        foreach (var (prefix, module) in _routes)
        {
            if (path.Equals(prefix, StringComparison.OrdinalIgnoreCase) ||
                path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase))
                return module;
        }
        return null;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
