@page "/catalogo/tarifas"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetPriceListsHandler GetPriceLists
@inject CreatePriceListHandler CreateHandler
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Tarifas — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tarifas de venta</h1>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nueva tarifa</button>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <div class="input-group" style="max-width:340px">
        <input class="form-control" placeholder="Nombre…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        <button class="btn btn-outline-secondary" @onclick="Search">Buscar</button>
    </div>
    <select class="form-select" style="max-width:160px" @onchange="OnActiveChanged">
        <option value="">Todas</option>
        <option value="true">Activas</option>
        <option value="false">Inactivas</option>
    </select>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Vigencia</th>
                        <th class="text-center">Artículos</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pl in _result.Items)
                    {
                        <tr style="cursor:pointer" @onclick="() => GoToDetail(pl.Id)">
                            <td><strong>@pl.Name</strong></td>
                            <td class="text-muted">@(pl.Description ?? "—")</td>
                            <td>
                                @if (pl.ValidFrom.HasValue || pl.ValidTo.HasValue)
                                {
                                    <span>@(pl.ValidFrom?.ToString("dd/MM/yyyy") ?? "…") – @(pl.ValidTo?.ToString("dd/MM/yyyy") ?? "…")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin límite</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@pl.ItemCount</span>
                            </td>
                            <td>
                                @if (pl.IsActive)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiva</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => GoToDetail(pl.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                    @if (!_result.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron tarifas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(_result.HasPreviousPage ? "" : "disabled")">
                    <button class="page-link" @onclick="PrevPage">Anterior</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @_result.Page de @_result.TotalPages (@_result.TotalCount total)</span>
                </li>
                <li class="page-item @(_result.HasNextPage ? "" : "disabled")">
                    <button class="page-link" @onclick="NextPage">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (_showCreate)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva tarifa</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_form" OnValidSubmit="CreatePriceList">
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="_form.Name" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <InputTextArea class="form-control" @bind-Value="_form.Description" rows="2" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Válida desde</label>
                                <InputDate class="form-control" @bind-Value="_form.ValidFrom" TValue="DateOnly?" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Válida hasta</label>
                                <InputDate class="form-control" @bind-Value="_form.ValidTo" TValue="DateOnly?" />
                            </div>
                        </div>
                        @if (_createError is not null)
                        {
                            <div class="alert alert-danger mt-2">@_createError</div>
                        }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreate">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">
                                @(_saving ? "Guardando…" : "Crear tarifa")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<PriceListSummaryDto>? _result;
    private string? _search;
    private bool? _isActive = true;
    private int _page = 1;
    private bool _loading;
    private bool _showCreate;
    private bool _saving;
    private string? _createError;
    private PriceListForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _result = await GetPriceLists.Handle(new GetPriceListsQuery(_search, _isActive, _page, 20));
        _loading = false;
    }

    private async Task Search() { _page = 1; await LoadAsync(); }
    private async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private async Task OnActiveChanged(ChangeEventArgs e)
    {
        _isActive = bool.TryParse(e.Value?.ToString(), out var b) ? b : null;
        _page = 1;
        await LoadAsync();
    }

    private void GoToDetail(Guid id) => Nav.NavigateTo($"/catalogo/tarifas/{id}");

    private void OpenCreate() { _form = new(); _createError = null; _showCreate = true; }
    private void CloseCreate() => _showCreate = false;

    private async Task CreatePriceList()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) { _createError = "El nombre es obligatorio."; return; }
        _saving = true;
        _createError = null;
        try
        {
            var pl = await CreateHandler.Handle(new CreatePriceListCommand(
                _form.Name!, _form.Description,
                _form.ValidFrom, _form.ValidTo, "web"));
            _showCreate = false;
            Toast.Show("Tarifa creada correctamente");
            Nav.NavigateTo($"/catalogo/tarifas/{pl.Id}");
        }
        catch (ArgumentException ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    private sealed class PriceListForm
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public DateOnly? ValidFrom { get; set; }
        public DateOnly? ValidTo { get; set; }
    }
}
