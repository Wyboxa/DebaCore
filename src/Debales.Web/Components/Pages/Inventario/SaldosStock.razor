@page "/inventario/saldos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetStockBalanceHandler GetBalance
@inject GetWarehousesHandler GetWarehouses
@inject AdjustStockHandler AdjustHandler
@inject ToastService Toast

<PageTitle>Saldos de stock — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Saldos de stock</h1>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <div class="input-group" style="max-width:280px">
        <input class="form-control" placeholder="Código o nombre de artículo…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        <button class="btn btn-outline-secondary" @onclick="ApplySearch">Buscar</button>
    </div>
    <select class="form-select" style="max-width:220px" @onchange="OnWarehouseChanged">
        <option value="">Todos los almacenes</option>
        @foreach (var w in _warehouses)
        {
            <option value="@w.Id">@w.Name</option>
        }
    </select>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (_balances.Count == 0)
    {
        <div class="alert alert-light border">Sin movimientos de stock registrados todavía.</div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="alert alert-light border">Sin resultados para la búsqueda.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-muted">@_filtered.Count artículo(s)</small>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Almacén</th>
                            <th>Código</th>
                            <th>Artículo</th>
                            <th class="text-end">Stock</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in _filtered)
                        {
                            <tr>
                                <td>@b.WarehouseName</td>
                                <td><code>@b.ItemCode</code></td>
                                <td>@b.ItemName</td>
                                <td class="text-end fw-semibold @(b.Quantity < 0 ? "text-danger" : b.Quantity == 0 ? "text-muted" : "")">
                                    @b.Quantity.ToString("N4")
                                </td>
                                <td>
                                    @if (b.Quantity < 0)
                                    {
                                        <span class="badge bg-danger">Stock negativo</span>
                                    }
                                    else if (b.Quantity == 0)
                                    {
                                        <span class="badge bg-secondary">Sin stock</span>
                                    }
                                    else if (b.MinimumStock.HasValue && b.Quantity < b.MinimumStock.Value)
                                    {
                                        <span class="badge bg-warning text-dark" title="Mínimo: @b.MinimumStock.Value.ToString("N4")">Bajo mínimo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenAdjust(b)">Ajustar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_showAdjust && _adjustTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajuste de inventario</h5>
                    <button class="btn-close" @onclick="CloseAdjust"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="fw-semibold">@_adjustTarget.ItemCode — @_adjustTarget.ItemName</div>
                        <div class="text-muted small">Almacén: @_adjustTarget.WarehouseName</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Stock actual</label>
                            <input class="form-control" value="@_adjustTarget.Quantity.ToString("N4")" disabled />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Nueva cantidad *</label>
                            <input class="form-control" type="number" step="0.0001" @bind="_adjustQty" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Motivo</label>
                            <input class="form-control" @bind="_adjustReason" placeholder="Ej: Recuento físico, corrección de error…" />
                        </div>
                        @if (_adjustQty.HasValue)
                        {
                            var delta = _adjustQty.Value - _adjustTarget.Quantity;
                            <div class="col-12">
                                <div class="alert @(delta == 0 ? "alert-secondary" : delta > 0 ? "alert-success" : "alert-warning") py-2 mb-0">
                                    Diferencia: <strong>@(delta > 0 ? "+" : "")@delta.ToString("N4")</strong>
                                    @if (delta == 0) { <span class="text-muted ms-2">Sin cambio</span> }
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_adjustError))
                    {
                        <div class="alert alert-danger py-2 mt-3">@_adjustError</div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="CloseAdjust">Cancelar</button>
                        <button type="button" class="btn btn-primary" disabled="@_adjustSaving" @onclick="ExecuteAdjust">
                            @if (_adjustSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Aplicar ajuste
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool _loading = true;
    string? _search;
    List<StockBalanceDto> _balances = [];
    List<StockBalanceDto> _filtered = [];
    List<WarehouseSummaryDto> _warehouses = [];
    Guid? _warehouseFilter;

    // Adjust form
    bool _showAdjust;
    bool _adjustSaving;
    string? _adjustError;
    StockBalanceDto? _adjustTarget;
    decimal? _adjustQty;
    string? _adjustReason;

    protected override async Task OnInitializedAsync()
    {
        _warehouses = (await GetWarehouses.Handle(new GetWarehousesQuery(true))).ToList();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _balances = (await GetBalance.Handle(new GetStockBalanceQuery(null, _warehouseFilter))).ToList();
        ApplyFilter();
        _loading = false;
    }

    void ApplyFilter()
    {
        _filtered = string.IsNullOrWhiteSpace(_search)
            ? _balances
            : _balances.Where(b =>
                b.ItemCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                b.ItemName.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    async Task ApplySearch() => ApplyFilter();

    async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    async Task OnWarehouseChanged(ChangeEventArgs e)
    {
        _warehouseFilter = Guid.TryParse(e.Value?.ToString(), out var v) ? v : null;
        await LoadAsync();
    }

    void OpenAdjust(StockBalanceDto b)
    {
        _adjustTarget = b;
        _adjustQty = b.Quantity;
        _adjustReason = null;
        _adjustError = null;
        _showAdjust = true;
    }

    void CloseAdjust() { _showAdjust = false; _adjustTarget = null; }

    async Task ExecuteAdjust()
    {
        if (_adjustTarget is null || !_adjustQty.HasValue) return;
        _adjustError = null;
        _adjustSaving = true;
        try
        {
            await AdjustHandler.Handle(new AdjustStockCommand(
                _adjustTarget.ItemId, _adjustTarget.WarehouseId,
                _adjustQty.Value, _adjustReason, "web"));
            Toast.Show($"Ajuste aplicado: {_adjustTarget.ItemCode} → {_adjustQty.Value:N4}");
            CloseAdjust();
            await LoadAsync();
        }
        catch (Exception ex) { _adjustError = ex.Message; }
        finally { _adjustSaving = false; }
    }
}
