@page "/configuracion"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Configuración — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Configuración</h1>
        <small class="text-muted">Parámetros generales, usuarios, módulos y preferencias de la plataforma</small>
    </div>
</div>

<div class="row g-3">
    @foreach (var section in _sections)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="opacity: @(section.Available ? "1" : "0.6")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-wrap @section.IconClass" style="width:40px;height:40px;border-radius:10px;">
                            @((MarkupString)section.IconSvg)
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@section.Title</div>
                            @if (!section.Available)
                            {
                                <span class="badge bg-light text-secondary border" style="font-size:0.62rem">Próximamente</span>
                            }
                        </div>
                    </div>
                    <p class="small text-muted mb-0">@section.Description</p>
                </div>
            </div>
        </div>
    }
</div>

