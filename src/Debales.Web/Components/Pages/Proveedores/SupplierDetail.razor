@page "/proveedores/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetSupplierByIdHandler GetById
@inject UpdateSupplierHandler UpdateHandler
@inject GetSupplierItemCodesHandler GetItemCodes
@inject UpsertSupplierItemCodeHandler UpsertItemCode
@inject DeleteSupplierItemCodeHandler DeleteItemCode
@inject GetItemsHandler GetItems
@inject GetPaymentTermsHandler GetPaymentTermsList
@inject ToastService Toast
@inject NavigationManager Nav

<PageTitle>@(_supplier?.Name ?? "Proveedor") — Debales</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_supplier is null)
{
    <div class="alert alert-warning">Proveedor no encontrado. <a href="/proveedores">Volver</a></div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/proveedores">Proveedores</a></li>
            <li class="breadcrumb-item active">@_supplier.Name</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1">@_supplier.Name</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (_supplier.TaxId is not null)
                {
                    <span class="text-muted small">@_supplier.TaxId</span>
                }
                @if (_supplier.IsActive)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </div>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="OpenEdit">Editar</button>
    </div>

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in new[] { "info", "notas", "codigos" })
        {
            <li class="nav-item">
                <button class="nav-link @(_tab == tab ? "active" : "")" @onclick="() => OnTabChange(tab)">
                    @TabLabel(tab)
                </button>
            </li>
        }
    </ul>

    @if (_tab == "info")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <dl class="mb-0">
                            <dt class="small text-muted fw-semibold mb-1">Nombre</dt>
                            <dd class="mb-3">@_supplier.Name</dd>

                            <dt class="small text-muted fw-semibold mb-1">CIF / NIF</dt>
                            <dd class="mb-3">@(_supplier.TaxId ?? "—")</dd>

                            <dt class="small text-muted fw-semibold mb-1">Persona de contacto</dt>
                            <dd class="mb-3">@(_supplier.ContactName ?? "—")</dd>

                            <dt class="small text-muted fw-semibold mb-1">Teléfono</dt>
                            <dd class="mb-3">@(_supplier.Phone ?? "—")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="mb-0">
                            <dt class="small text-muted fw-semibold mb-1">Email</dt>
                            <dd class="mb-3">
                                @if (_supplier.Email is not null)
                                {
                                    <a href="mailto:@_supplier.Email">@_supplier.Email</a>
                                }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Web</dt>
                            <dd class="mb-3">
                                @if (_supplier.Website is not null)
                                {
                                    <a href="@_supplier.Website" target="_blank" rel="noopener">@_supplier.Website</a>
                                }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Dirección</dt>
                            <dd class="mb-3">
                                @if (_supplier.Address is not null)
                                {
                                    <span>@_supplier.Address.Street, @_supplier.Address.City @_supplier.Address.PostalCode — @_supplier.Address.Country</span>
                                }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Cuenta contable</dt>
                            <dd class="mb-3">@(_supplier.AccountCode ?? "—")</dd>

                            <dt class="small text-muted fw-semibold mb-1">Condición de pago</dt>
                            <dd class="mb-3">
                                @if (_supplier.PaymentTermId.HasValue)
                                { <span>@(_supplier.PaymentTermName ?? "—")</span> }
                                else { <span>—</span> }
                            </dd>

                            <dt class="small text-muted fw-semibold mb-1">Alta</dt>
                            <dd class="mb-0">@_supplier.CreatedAt.ToString("dd/MM/yyyy")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_tab == "notas")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(_supplier.Notes))
                {
                    <p style="white-space:pre-wrap">@_supplier.Notes</p>
                }
                else
                {
                    <p class="text-muted mb-0">Sin notas. Edita el proveedor para añadir observaciones.</p>
                }
            </div>
        </div>
    }

    @if (_tab == "codigos")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Códigos de artículo del proveedor</span>
                <button class="btn btn-sm btn-primary" @onclick="OpenAddCode">+ Añadir código</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Artículo</th>
                            <th>Código proveedor</th>
                            <th>Descripción</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_codesLoading)
                        {
                            <tr><td colspan="4" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                        }
                        else
                        {
                            @foreach (var c in _itemCodes)
                            {
                                <tr>
                                    <td><code>@c.ItemCode</code> @c.ItemName</td>
                                    <td><strong>@c.SupplierCode</strong></td>
                                    <td class="text-muted">@(c.Description ?? "—")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                @onclick="() => OpenEditCode(c)">Editar</button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDeleteCode(c)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                            @if (!_itemCodes.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Sin códigos configurados.</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@* ── Add/edit item code modal ── *@
@if (_showCodeModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingCode is not null ? "Editar código" : "Añadir código")</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCodeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">Artículo *</label>
                            @if (_editingCode is not null)
                            {
                                <input class="form-control" readonly value="@(_editingCode.ItemCode + " — " + _editingCode.ItemName)" />
                            }
                            else
                            {
                                <select class="form-select" @bind="_codeForm.ItemIdStr">
                                    <option value="">Seleccionar…</option>
                                    @foreach (var item in _allItems)
                                    {
                                        <option value="@item.Id">@item.Code — @item.Name</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Código del proveedor *</label>
                            <InputText class="form-control text-uppercase" @bind-Value="_codeForm.SupplierCode" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control" @bind-Value="_codeForm.Description" />
                        </div>
                    </div>
                    @if (_codeError is not null) { <div class="alert alert-danger mt-2">@_codeError</div> }
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => _showCodeModal = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveCode" disabled="@_saving">
                            @(_saving ? "Guardando…" : "Guardar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ── Delete confirm ── *@
@if (_deletingCode is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="() => _deletingCode = null"></button>
                </div>
                <div class="modal-body">
                    ¿Eliminar el código <strong>@_deletingCode.SupplierCode</strong> para @_deletingCode.ItemName?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deletingCode = null">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDeleteCode" disabled="@_saving">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showEdit && _supplier is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar proveedor</h5>
                    <button type="button" class="btn-close" @onclick="() => _showEdit = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_editForm" OnValidSubmit="SaveEdit">
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="_editForm.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">CIF / NIF</label>
                                <InputText class="form-control" @bind-Value="_editForm.TaxId" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Persona de contacto</label>
                                <InputText class="form-control" @bind-Value="_editForm.ContactName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="_editForm.Phone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="_editForm.Email" type="email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Web</label>
                                <InputText class="form-control" @bind-Value="_editForm.Website" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Cuenta contable</label>
                                <InputText class="form-control" @bind-Value="_editForm.AccountCode" placeholder="p.ej. 4000001" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Condición de pago</label>
                                <select class="form-select" @bind="_editForm.PaymentTermIdStr">
                                    <option value="">Sin condición</option>
                                    @foreach (var pt in _availablePaymentTerms)
                                    {
                                        <option value="@pt.Id">@pt.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <hr class="my-2" />
                        <div class="small text-muted fw-semibold mb-2">Dirección</div>
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <label class="form-label">Calle</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressStreet" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ciudad</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressCity" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">C.P.</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressPostalCode" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">País</label>
                                <InputText class="form-control" @bind-Value="_editForm.AddressCountry" />
                            </div>
                        </div>
                        <hr class="my-2" />
                        <div class="mb-2">
                            <label class="form-label">Notas internas</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_editForm.Notes" />
                        </div>
                        @if (_editError is not null) { <div class="alert alert-danger mt-2">@_editError</div> }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="() => _showEdit = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SupplierDetailDto? _supplier;
    private bool _loading = true;
    private string _tab = "info";
    private bool _saving;
    private bool _showEdit;
    private string? _editError;
    private EditFormModel _editForm = new();

    private List<PaymentTermSummaryDto> _availablePaymentTerms = [];

    // ── Item codes ──────────────────────────────────────────────────────────
    private List<SupplierItemCodeDto> _itemCodes = [];
    private List<ItemSummaryDto> _allItems = [];
    private bool _codesLoading;
    private bool _showCodeModal;
    private SupplierItemCodeDto? _editingCode;
    private SupplierItemCodeDto? _deletingCode;
    private string? _codeError;
    private CodeForm _codeForm = new();

    protected override async Task OnInitializedAsync()
    {
        _supplier = await GetById.Handle(new GetSupplierByIdQuery(Id));
        _loading = false;
    }

    private static string TabLabel(string tab) => tab switch
    {
        "info"    => "Información",
        "notas"   => "Notas",
        "codigos" => "Códigos",
        _         => tab
    };

    private async Task OnTabChange(string tab)
    {
        _tab = tab;
        if (tab == "codigos" && !_itemCodes.Any())
            await LoadCodesAsync();
    }

    private async Task LoadCodesAsync()
    {
        _codesLoading = true;
        _itemCodes = await GetItemCodes.Handle(new GetSupplierItemCodesQuery(Id));
        _codesLoading = false;
    }

    private async Task OpenAddCode()
    {
        if (!_allItems.Any())
        {
            var paged = await GetItems.Handle(new GetItemsQuery(null, null, null, 1, 1000));
            _allItems = paged.Items.ToList();
        }
        _editingCode = null;
        _codeForm = new();
        _codeError = null;
        _showCodeModal = true;
    }

    private void OpenEditCode(SupplierItemCodeDto c)
    {
        _editingCode = c;
        _codeForm = new CodeForm { SupplierCode = c.SupplierCode, Description = c.Description };
        _codeError = null;
        _showCodeModal = true;
    }

    private async Task SaveCode()
    {
        var itemId = _editingCode?.ItemId ?? (Guid.TryParse(_codeForm.ItemIdStr, out var g) ? g : Guid.Empty);
        if (itemId == Guid.Empty) { _codeError = "Selecciona un artículo."; return; }
        if (string.IsNullOrWhiteSpace(_codeForm.SupplierCode)) { _codeError = "El código del proveedor es obligatorio."; return; }

        _saving = true;
        _codeError = null;
        try
        {
            await UpsertItemCode.Handle(new UpsertSupplierItemCodeCommand(
                Id, itemId, _codeForm.SupplierCode!, _codeForm.Description, "web"));
            _showCodeModal = false;
            await LoadCodesAsync();
            Toast.Show("Código guardado");
        }
        catch (Exception ex) { _codeError = ex.Message; }
        finally { _saving = false; }
    }

    private void ConfirmDeleteCode(SupplierItemCodeDto c) => _deletingCode = c;

    private async Task ExecuteDeleteCode()
    {
        if (_deletingCode is null) return;
        _saving = true;
        try
        {
            await DeleteItemCode.Handle(new DeleteSupplierItemCodeCommand(Id, _deletingCode.ItemId));
            _deletingCode = null;
            await LoadCodesAsync();
            Toast.Show("Código eliminado");
        }
        catch (Exception ex) { Toast.Show(ex.Message); }
        finally { _saving = false; }
    }

    private sealed class CodeForm
    {
        public string? ItemIdStr { get; set; }
        public string? SupplierCode { get; set; }
        public string? Description { get; set; }
    }

    private async Task OpenEdit()
    {
        _editError = null;
        if (!_availablePaymentTerms.Any())
        {
            var pts = await GetPaymentTermsList.Handle(new GetPaymentTermsQuery(Page: 1, PageSize: 200));
            _availablePaymentTerms = pts.Items.ToList();
        }
        _editForm = new()
        {
            Name          = _supplier!.Name,
            TaxId         = _supplier.TaxId,
            Phone         = _supplier.Phone,
            Email         = _supplier.Email,
            Website       = _supplier.Website,
            ContactName   = _supplier.ContactName,
            Notes         = _supplier.Notes,
            AddressStreet     = _supplier.Address?.Street,
            AddressCity       = _supplier.Address?.City,
            AddressPostalCode = _supplier.Address?.PostalCode,
            AddressCountry    = _supplier.Address?.Country,
            AccountCode       = _supplier.AccountCode,
            PaymentTermIdStr  = _supplier.PaymentTermId?.ToString() ?? ""
        };
        _showEdit = true;
    }

    private async Task SaveEdit()
    {
        _saving = true;
        _editError = null;
        try
        {
            var paymentTermId = Guid.TryParse(_editForm.PaymentTermIdStr, out var ptg) ? ptg : (Guid?)null;
            _supplier = await UpdateHandler.Handle(new UpdateSupplierCommand(
                Id, _editForm.Name!, _editForm.TaxId, _editForm.Phone, _editForm.Email,
                _editForm.Website, _editForm.ContactName, _editForm.Notes,
                _editForm.AddressStreet, _editForm.AddressCity,
                _editForm.AddressPostalCode, _editForm.AddressCountry, "web",
                AccountCode: _editForm.AccountCode,
                PaymentTermId: paymentTermId));
            _showEdit = false;
            Toast.Show("Proveedor actualizado correctamente");
        }
        catch (ArgumentException ex) { _editError = ex.Message; }
        catch (KeyNotFoundException) { _editError = "Proveedor no encontrado."; }
        finally { _saving = false; }
    }

    private sealed class EditFormModel
    {
        public string? Name { get; set; }
        public string? TaxId { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Website { get; set; }
        public string? ContactName { get; set; }
        public string? Notes { get; set; }
        public string? AddressStreet { get; set; }
        public string? AddressCity { get; set; }
        public string? AddressPostalCode { get; set; }
        public string? AddressCountry { get; set; }
        public string? AccountCode { get; set; }
        public string? PaymentTermIdStr { get; set; }
    }
}
