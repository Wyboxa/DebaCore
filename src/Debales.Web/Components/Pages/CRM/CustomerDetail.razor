@page "/crm/customers/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetCustomerByIdHandler GetById
@inject UpdateCustomerHandler UpdateHandler
@inject AddContactHandler AddContactHandler
@inject GetContactsByCustomerHandler GetContacts
@inject LogActivityHandler LogActivity
@inject GetActivitiesByCustomerHandler GetActivities
@inject Debales.Application.CRM.Notes.Commands.AddNote.AddNoteHandler AddNoteHandler
@inject Debales.Application.CRM.Notes.Queries.GetNotesByCustomer.GetNotesByCustomerHandler GetNotes
@inject GetOpportunitiesByCustomerHandler GetOpportunities
@inject CreateOpportunityHandler CreateOppHandler
@inject UpdateOpportunityStatusHandler UpdateOppStatusHandler
@inject CompleteActivityHandler CompleteActivityHandler
@inject Debales.Application.AI.Chat.ChatWithCustomerHandler ChatHandler
@inject Debales.Application.AI.Summary.GetCustomerSummaryHandler SummaryHandler
@inject GetCustomerItemCodesHandler GetCustomerItemCodes
@inject UpsertCustomerItemCodeHandler UpsertCustomerItemCode
@inject DeleteCustomerItemCodeHandler DeleteCustomerItemCode
@inject GetItemsHandler GetItems
@inject GetPriceListsHandler GetPriceLists
@inject GetPaymentTermsHandler GetPaymentTermsList
@inject GetPaymentMethodsHandler GetPaymentMethodsList
@inject GetCustomerStatementHandler StatementHandler
@inject GetSalesOrdersHandler GetOrders
@inject ToastService Toast
@inject NavigationManager Nav

<PageTitle>@(_customer?.Name ?? "Cliente") — Debales CRM</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_customer is null)
{
    <div class="alert alert-warning">Cliente no encontrado. <a href="/crm/customers">Volver</a></div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/crm/customers">Clientes</a></li>
            <li class="breadcrumb-item active">@_customer.Name</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1">@_customer.Name</h1>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                @if (_customer.Sector is not null) { <span class="text-muted small">@_customer.Sector</span> }
                @if (_customer.TaxId is not null) { <span class="text-muted small">· @_customer.TaxId</span> }
                @if (_customer.IsActive) { <span class="badge bg-success">Activo</span> }
                else { <span class="badge bg-secondary">Inactivo</span> }
            </div>
            @{
                var openOpps    = _opportunities.Count(o => o.Status is "New" or "InProgress");
                var pipelineVal = _opportunities.Where(o => o.Status is "New" or "InProgress").Sum(o => o.EstimatedValue ?? 0m);
                var pending     = _activities.Count(a => !a.IsCompleted);
                var overdue     = _activities.Count(a => !a.IsCompleted && a.ScheduledAt < DateTime.UtcNow);
            }
            <div class="d-flex flex-wrap gap-2">
                @if (_contacts.Any())
                {
                    <span class="badge bg-light text-dark border">@_contacts.Count contacto(s)</span>
                }
                @if (openOpps > 0)
                {
                    <span class="badge bg-light text-dark border">@openOpps opp · @pipelineVal.ToString("N0") €</span>
                }
                @if (overdue > 0)
                {
                    <span class="badge bg-danger">@overdue vencida(s)</span>
                }
                else if (pending > 0)
                {
                    <span class="badge bg-warning text-dark">@pending pendiente(s)</span>
                }
            </div>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="OpenEdit" disabled="@_saving">Editar</button>
    </div>

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in new[] { "info", "contactos", "actividades", "notas", "oportunidades", "historial", "codigos", "pedidos", "cuenta", "asistente" })
        {
            <li class="nav-item">
                <button class="nav-link @(_tab == tab ? "active" : "")" @onclick="() => SetTab(tab)">
                    @TabLabel(tab)
                </button>
            </li>
        }
    </ul>

    @if (_tab == "info")
    {
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">@_customer.Name</dd>
                    <dt class="col-sm-3">Sector</dt>
                    <dd class="col-sm-9">@(_customer.Sector ?? "—")</dd>
                    <dt class="col-sm-3">CIF / NIF</dt>
                    <dd class="col-sm-9">@(_customer.TaxId ?? "—")</dd>
                    <dt class="col-sm-3">Teléfono</dt>
                    <dd class="col-sm-9">@(_customer.Phone ?? "—")</dd>
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">
                        @if (_customer.Email is not null)
                        {
                            <a href="mailto:@_customer.Email">@_customer.Email</a>
                        }
                        else { <span>—</span> }
                    </dd>
                    <dt class="col-sm-3">Web</dt>
                    <dd class="col-sm-9">
                        @if (_customer.Website is not null)
                        {
                            <a href="@_customer.Website" target="_blank" rel="noopener">@_customer.Website</a>
                        }
                        else { <span>—</span> }
                    </dd>
                    <dt class="col-sm-3">Dirección</dt>
                    <dd class="col-sm-9">
                        @if (_customer.Address is not null)
                        {
                            <span>@_customer.Address.Street, @_customer.Address.City @_customer.Address.PostalCode — @_customer.Address.Country</span>
                        }
                        else { <span>—</span> }
                    </dd>
                    <dt class="col-sm-3">Cuenta contable</dt>
                    <dd class="col-sm-9">@(_customer.AccountCode ?? "—")</dd>
                    <dt class="col-sm-3">Tarifa de precio</dt>
                    <dd class="col-sm-9">
                        @if (_customer.PriceListId.HasValue)
                        { <a href="/catalogo/tarifas/@_customer.PriceListId">@(_customer.PriceListName ?? "—")</a> }
                        else { <span>—</span> }
                    </dd>
                    <dt class="col-sm-3">Condición de pago</dt>
                    <dd class="col-sm-9">
                        @if (_customer.PaymentTermId.HasValue)
                        { <span>@(_customer.PaymentTermName ?? "—")</span> }
                        else { <span>—</span> }
                    </dd>
                    <dt class="col-sm-3">Forma de pago</dt>
                    <dd class="col-sm-9">
                        @if (_customer.PaymentMethodId.HasValue)
                        { <span>@(_customer.PaymentMethodName ?? "—")</span> }
                        else { <span>—</span> }
                    </dd>
                    <dt class="col-sm-3">Alta</dt>
                    <dd class="col-sm-9">@_customer.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>
    }

    @if (_tab == "contactos")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Contactos (@_contacts.Count)</h5>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddContact">+ Añadir contacto</button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Nombre</th><th>Cargo</th><th>Email</th><th>Teléfono</th><th>Estado</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in _contacts)
                    {
                        <tr>
                            <td>@c.FullName</td>
                            <td>@(c.JobTitle ?? "—")</td>
                            <td>@(c.Email ?? "—")</td>
                            <td>@(c.Phone ?? "—")</td>
                            <td>@(c.IsActive ? "Activo" : "Inactivo")</td>
                        </tr>
                    }
                    @if (!_contacts.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">Sin contactos.</td></tr> }
                </tbody>
            </table>
        </div>

        @if (_showAddContact)
        {
            <div class="card mt-3">
                <div class="card-header">Nuevo contacto</div>
                <div class="card-body">
                    <EditForm Model="_contactForm" OnValidSubmit="SaveContact">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="_contactForm.FirstName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellidos *</label>
                                <InputText class="form-control" @bind-Value="_contactForm.LastName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cargo</label>
                                <InputText class="form-control" @bind-Value="_contactForm.JobTitle" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="_contactForm.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="_contactForm.Phone" />
                            </div>
                        </div>
                        @if (_contactError is not null) { <div class="alert alert-danger mt-2">@_contactError</div> }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="() => _showAddContact = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    }

    @if (_tab == "actividades")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Actividades (@_activities.Count)</h5>
            <button class="btn btn-sm btn-primary" @onclick="OpenLogActivity">+ Registrar actividad</button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Tipo</th><th>Asunto</th><th>Fecha</th><th>Asignado a</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in _activities.OrderByDescending(x => x.ScheduledAt))
                    {
                        <tr class="@(a.IsCompleted ? "text-muted" : "")">
                            <td><span class="badge bg-secondary">@ActivityTypeLabel(a.Type)</span></td>
                            <td>@a.Subject</td>
                            <td>@a.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(a.AssignedTo ?? "—")</td>
                            <td>
                                @if (a.IsCompleted)
                                {
                                    <span class="badge bg-success">Completada</span>
                                }
                                else if (a.ScheduledAt < DateTime.UtcNow)
                                {
                                    <span class="badge bg-danger">Vencida</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!a.IsCompleted)
                                {
                                    <button class="btn btn-sm btn-outline-success"
                                            @onclick="() => CompleteActivity(a.Id)"
                                            disabled="@_saving">
                                        Completar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_activities.Any()) { <tr><td colspan="6" class="text-center text-muted py-3">Sin actividades.</td></tr> }
                </tbody>
            </table>
        </div>

        @if (_showLogActivity)
        {
            <div class="card mt-3">
                <div class="card-header">Nueva actividad</div>
                <div class="card-body">
                    <EditForm Model="_actForm" OnValidSubmit="SaveActivity">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Tipo *</label>
                                <InputSelect class="form-select" @bind-Value="_actForm.Type">
                                    @foreach (ActivityType t in Enum.GetValues<ActivityType>())
                                    {
                                        <option value="@t">@ActivityTypeLabel(t.ToString())</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Asunto *</label>
                                <InputText class="form-control" @bind-Value="_actForm.Subject" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha programada *</label>
                                <InputDate class="form-control" @bind-Value="_actForm.ScheduledAt" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Asignado a</label>
                                <InputText class="form-control" @bind-Value="_actForm.AssignedTo" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notas</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="_actForm.Notes" />
                            </div>
                        </div>
                        @if (_actError is not null) { <div class="alert alert-danger mt-2">@_actError</div> }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="() => _showLogActivity = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    }

    @if (_tab == "notas")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Notas (@_notes.Count)</h5>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddNote">+ Añadir nota</button>
        </div>

        @foreach (var n in _notes)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <p class="mb-1">@n.Content</p>
                    <small class="text-muted">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm") · @(n.CreatedBy ?? "—")</small>
                </div>
            </div>
        }
        @if (!_notes.Any()) { <p class="text-muted">Sin notas.</p> }

        @if (_showAddNote)
        {
            <div class="card mt-3">
                <div class="card-header">Nueva nota</div>
                <div class="card-body">
                    <EditForm Model="_noteForm" OnValidSubmit="SaveNote">
                        <div class="mb-2">
                            <InputTextArea class="form-control" rows="3" placeholder="Escribe aquí…" @bind-Value="_noteForm.Content" />
                        </div>
                        @if (_noteError is not null) { <div class="alert alert-danger">@_noteError</div> }
                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-secondary" @onclick="() => _showAddNote = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    }

    @if (_tab == "oportunidades")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Oportunidades (@_opportunities.Count)</h5>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddOpp">+ Nueva oportunidad</button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Título</th><th>Estado</th><th>Valor estimado</th><th>Cierre esperado</th></tr>
                </thead>
                <tbody>
                    @foreach (var o in _opportunities)
                    {
                        <tr>
                            <td class="fw-semibold">@o.Title</td>
                            <td>
                                <select class="form-select form-select-sm"
                                        style="width:130px"
                                        value="@o.Status"
                                        @onchange="async e => await ChangeOppStatus(o.Id, e.Value?.ToString())"
                                        disabled="@_saving">
                                    <option value="New"        class="@(o.Status == "New"        ? "fw-bold" : "")">Nuevo</option>
                                    <option value="InProgress" class="@(o.Status == "InProgress" ? "fw-bold" : "")">En curso</option>
                                    <option value="Won"        class="@(o.Status == "Won"        ? "fw-bold" : "")">Ganado</option>
                                    <option value="Lost"       class="@(o.Status == "Lost"       ? "fw-bold" : "")">Perdido</option>
                                </select>
                            </td>
                            <td>@(o.EstimatedValue.HasValue ? o.EstimatedValue.Value.ToString("N0") + " €" : "—")</td>
                            <td>@(o.ExpectedCloseDate.HasValue ? o.ExpectedCloseDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                        </tr>
                    }
                    @if (!_opportunities.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">Sin oportunidades.</td></tr> }
                </tbody>
            </table>
        </div>

        @if (_showAddOpp)
        {
            <div class="card mt-3">
                <div class="card-header">Nueva oportunidad</div>
                <div class="card-body">
                    <EditForm Model="_oppForm" OnValidSubmit="SaveOpp">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Título *</label>
                                <InputText class="form-control" @bind-Value="_oppForm.Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Valor estimado (€)</label>
                                <InputNumber class="form-control" @bind-Value="_oppForm.EstimatedValue" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de cierre esperada</label>
                                <InputDate class="form-control" @bind-Value="_oppForm.ExpectedCloseDate" />
                            </div>
                        </div>
                        @if (_oppError is not null) { <div class="alert alert-danger mt-2">@_oppError</div> }
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="() => _showAddOpp = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    }

    @if (_tab == "historial")
    {
        var items = BuildTimeline().ToList();
        @if (!items.Any())
        {
            <p class="text-muted py-3">Sin actividad registrada para este cliente.</p>
        }
        else
        {
            <div class="timeline">
                @foreach (var item in items)
                {
                    <div class="timeline-item">
                        <div class="timeline-dot @item.DotClass"></div>
                        <div class="timeline-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="fw-semibold small">@item.Title</span>
                                <small class="text-muted text-nowrap ms-2">@item.Date.ToString("dd/MM/yy HH:mm")</small>
                            </div>
                            @if (item.Detail is not null)
                            {
                                <p class="mb-1 text-muted small" style="white-space:pre-wrap">@item.Detail</p>
                            }
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge @item.BadgeClass">@item.KindLabel</span>
                                @if (item.IsOverdue)  { <span class="badge bg-danger">Vencida</span> }
                                @if (item.IsPending)  { <span class="badge bg-warning text-dark">Pendiente</span> }
                                @if (item.Author is not null) { <small class="text-muted">@item.Author</small> }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (_tab == "codigos")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Códigos de artículo del cliente</span>
                <button class="btn btn-sm btn-primary" @onclick="OpenAddCustomerCode">+ Añadir código</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Artículo</th>
                            <th>Código cliente</th>
                            <th>Descripción</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_customerCodesLoading)
                        {
                            <tr><td colspan="4" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                        }
                        else
                        {
                            @foreach (var c in _customerCodes)
                            {
                                <tr>
                                    <td><code>@c.ItemCode</code> @c.ItemName</td>
                                    <td><strong>@c.CustomerCode</strong></td>
                                    <td class="text-muted">@(c.Description ?? "—")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                @onclick="() => OpenEditCustomerCode(c)">Editar</button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDeleteCustomerCode(c)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                            @if (!_customerCodes.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Sin códigos configurados.</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_tab == "pedidos")
    {
        @if (_pedidosLoading)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (!_pedidos.Any())
        {
            <div class="alert alert-info">Sin pedidos de venta registrados para este cliente.</div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Pedidos de venta</span>
                    <a href="/ventas/pedidos" class="btn btn-sm btn-outline-secondary">Ver todos</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Número</th>
                                <th>Fecha</th>
                                <th>F. entrega</th>
                                <th>Estado</th>
                                <th class="text-end pe-3">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in _pedidos.OrderByDescending(p => p.Date))
                            {
                                <tr style="cursor:pointer" @onclick="() => GoToOrder(o.Id)">
                                    <td class="ps-3 font-monospace small">@o.Number</td>
                                    <td class="small">@o.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="small text-muted">@(o.RequestedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td><span class="badge @OrderBadge(o.Status)">@o.StatusLabel</span></td>
                                    <td class="text-end pe-3 fw-semibold">@o.Total.ToString("N2") €</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    @if (_tab == "cuenta")
    {
        @if (_statementLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (_statement is not null)
        {
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-1">Total cargos</div>
                            <div class="fw-bold fs-5">@_statement.TotalDebit.ToString("N2") €</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-1">Total abonos</div>
                            <div class="fw-bold fs-5 text-success">@_statement.TotalCredit.ToString("N2") €</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100 @(_statement.Balance > 0 ? "border-start border-warning border-3" : "")">
                        <div class="card-body">
                            <div class="text-muted small mb-1">Saldo pendiente</div>
                            <div class="fw-bold fs-5 @(_statement.Balance > 0 ? "text-warning" : "text-success")">@_statement.Balance.ToString("N2") €</div>
                        </div>
                    </div>
                </div>
            </div>
            @if (_statement.Lines.Count == 0)
            {
                <div class="alert alert-info">Sin movimientos registrados.</div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Fecha</th>
                                    <th>Tipo</th>
                                    <th>Referencia</th>
                                    <th class="text-end">Cargo</th>
                                    <th class="text-end">Abono</th>
                                    <th class="text-end pe-3">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in _statement.Lines)
                                {
                                    <tr>
                                        <td class="ps-3 small">@l.Date.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge @CustomerStmtBadge(l.Type)">@l.Type</span></td>
                                        <td class="font-monospace small">@l.Reference</td>
                                        <td class="text-end small">@(l.Debit > 0 ? l.Debit.ToString("N2") + " €" : "—")</td>
                                        <td class="text-end small text-success">@(l.Credit > 0 ? l.Credit.ToString("N2") + " €" : "—")</td>
                                        <td class="text-end pe-3 fw-semibold @(l.Balance > 0 ? "text-warning" : "text-success")">@l.Balance.ToString("N2") €</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }

    @if (_tab == "asistente")
    {
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Resumen IA</span>
                        <button class="btn btn-sm btn-outline-primary" @onclick="LoadSummary" disabled="@_summaryLoading">
                            @(_summaryLoading ? "Generando…" : "↺ Actualizar")
                        </button>
                    </div>
                    <div class="card-body">
                        @if (_summaryLoading)
                        {
                            <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                        }
                        else if (_summary is not null)
                        {
                            <p class="mb-0" style="white-space:pre-wrap">@_summary</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Pulsa "Actualizar" para generar un resumen del cliente.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">Chat con contexto del cliente</div>
                    <div class="card-body p-0">
                        <div class="p-3" style="height:360px;overflow-y:auto;background:#f8f9fa;" id="chat-messages">
                            @if (!_chatMessages.Any())
                            {
                                <p class="text-muted text-center mt-5">Escribe un mensaje para empezar.</p>
                            }
                            @foreach (var msg in _chatMessages)
                            {
                                <div class="d-flex @(msg.Role == "user" ? "justify-content-end" : "justify-content-start") mb-2">
                                    <div class="px-3 py-2 rounded-3 @(msg.Role == "user" ? "bg-primary text-white" : "bg-white border")"
                                         style="max-width:80%;white-space:pre-wrap;font-size:.9rem">
                                        @msg.Content
                                    </div>
                                </div>
                            }
                            @if (_chatLoading)
                            {
                                <div class="d-flex justify-content-start mb-2">
                                    <div class="px-3 py-2 rounded-3 bg-white border text-muted" style="font-size:.9rem">
                                        <span class="spinner-border spinner-border-sm me-1"></span> Pensando…
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="input-group">
                            <input class="form-control" placeholder="Escribe tu pregunta…"
                                   @bind="_chatInput" @bind:event="oninput"
                                   @onkeydown="OnChatKeyDown" disabled="@_chatLoading" />
                            <button class="btn btn-primary" @onclick="SendChatMessage"
                                    disabled="@(_chatLoading || string.IsNullOrWhiteSpace(_chatInput))">
                                Enviar
                            </button>
                        </div>
                        @if (_chatError is not null)
                        {
                            <small class="text-danger mt-1 d-block">@_chatError</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@* ── Customer item code modals ── *@
@if (_showCustomerCodeModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingCustomerCode is not null ? "Editar código" : "Añadir código")</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCustomerCodeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">Artículo *</label>
                            @if (_editingCustomerCode is not null)
                            {
                                <input class="form-control" readonly value="@(_editingCustomerCode.ItemCode + " — " + _editingCustomerCode.ItemName)" />
                            }
                            else
                            {
                                <select class="form-select" @bind="_customerCodeForm.ItemIdStr">
                                    <option value="">Seleccionar…</option>
                                    @foreach (var item in _allItemsForCodes)
                                    {
                                        <option value="@item.Id">@item.Code — @item.Name</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Código del cliente *</label>
                            <InputText class="form-control text-uppercase" @bind-Value="_customerCodeForm.CustomerCode" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control" @bind-Value="_customerCodeForm.Description" />
                        </div>
                    </div>
                    @if (_customerCodeError is not null) { <div class="alert alert-danger mt-2">@_customerCodeError</div> }
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => _showCustomerCodeModal = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveCustomerCode" disabled="@_saving">
                            @(_saving ? "Guardando…" : "Guardar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_deletingCustomerCode is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="() => _deletingCustomerCode = null"></button>
                </div>
                <div class="modal-body">
                    ¿Eliminar el código <strong>@_deletingCustomerCode.CustomerCode</strong> para @_deletingCustomerCode.ItemName?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deletingCustomerCode = null">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDeleteCustomerCode" disabled="@_saving">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showEdit && _customer is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar cliente</h5>
