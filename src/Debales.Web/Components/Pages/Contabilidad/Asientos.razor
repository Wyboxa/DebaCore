@page "/contabilidad/asientos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GetAccountingEntriesHandler GetEntries
@inject GetAccountingEntryByIdHandler GetEntryById
@inject GetAccountingJournalsHandler GetJournals
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Asientos Contables — Debales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Asientos contables</h1>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" placeholder="Buscar por número o descripción…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="_journalId" @bind:after="Search">
            <option value="">Todos los diarios</option>
            @foreach (var j in _journals)
            {
                <option value="@j.Id">@j.Code — @j.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="Search">Buscar</button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_result is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Diario</th>
                        <th>Descripción</th>
                        <th class="text-end">Debe</th>
                        <th class="text-end">Haber</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in _result.Items)
                    {
                        <tr style="cursor:pointer" @onclick="() => OpenDetail(e.Id)">
                            <td><code>@e.Number</code></td>
                            <td>@e.Date.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-secondary">@e.JournalCode</span></td>
                            <td>@e.Description</td>
                            <td class="text-end">@e.TotalDebit.ToString("N2")</td>
                            <td class="text-end">@e.TotalCredit.ToString("N2")</td>
                            <td>
                                <span class="badge @StatusBadge(e.Status)">@e.StatusLabel</span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenDetail(e.Id)">Ver</button>
                            </td>
                        </tr>
                    }
                    @if (!_result.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No se encontraron asientos.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(_result.HasPreviousPage ? "" : "disabled")">
                    <button class="page-link" @onclick="PrevPage">Anterior</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @_result.Page de @_result.TotalPages (@_result.TotalCount total)</span>
                </li>
                <li class="page-item @(_result.HasNextPage ? "" : "disabled")">
                    <button class="page-link" @onclick="NextPage">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (_selected is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Asiento <code>@_selected.Number</code></h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4"><strong>Fecha:</strong> @_selected.Date.ToString("dd/MM/yyyy")</div>
                        <div class="col-md-4"><strong>Diario:</strong> @_selected.JournalCode — @_selected.JournalName</div>
                        <div class="col-md-4"><strong>Estado:</strong> <span class="badge @StatusBadge(_selected.Status)">@_selected.StatusLabel</span></div>
                        <div class="col-12 mt-2"><strong>Descripción:</strong> @_selected.Description</div>
                        @if (_selected.SourceType is not null)
                        {
                            <div class="col-12 mt-1 text-muted small">Origen: @_selected.SourceType</div>
                        }
                    </div>

                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Cuenta</th>
                                <th>Descripción</th>
                                <th class="text-end">Debe</th>
                                <th class="text-end">Haber</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _selected.Lines.OrderBy(x => x.SortOrder))
                            {
                                <tr>
                                    <td><code>@l.AccountCode</code></td>
                                    <td>@l.Description</td>
                                    <td class="text-end">@(l.Debit > 0 ? l.Debit.ToString("N2") : "—")</td>
                                    <td class="text-end">@(l.Credit > 0 ? l.Credit.ToString("N2") : "—")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold">
                            <tr>
                                <td colspan="2" class="text-end">Totales:</td>
                                <td class="text-end">@_selected.TotalDebit.ToString("N2")</td>
                                <td class="text-end">@_selected.TotalCredit.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>

                    @if (!_selected.IsBalanced)
                    {
                        <div class="alert alert-danger">El asiento no está cuadrado.</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<AccountingEntrySummaryDto>? _result;
    private AccountingEntryDetailDto? _selected;
    private IReadOnlyList<AccountingJournalDto> _journals = [];
    private string? _search;
    private string? _journalId;
    private int _page = 1;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _journals = await GetJournals.Handle(new GetAccountingJournalsQuery());
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        var journalGuid = Guid.TryParse(_journalId, out var g) ? (Guid?)g : null;
        _result = await GetEntries.Handle(new GetAccountingEntriesQuery(_search, journalGuid, null, _page, 20));
        _loading = false;
    }

    private async Task Search() { _page = 1; await LoadAsync(); }
    private async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private async Task OpenDetail(Guid id)
    {
        _selected = await GetEntryById.Handle(new GetAccountingEntryByIdQuery(id));
    }

    private void CloseDetail() => _selected = null;

    private static string StatusBadge(EntryStatus s) => s switch
    {
        EntryStatus.Draft => "bg-warning text-dark",
        EntryStatus.Posted => "bg-success",
        EntryStatus.Cancelled => "bg-secondary",
        _ => "bg-light text-dark"
    };
}
